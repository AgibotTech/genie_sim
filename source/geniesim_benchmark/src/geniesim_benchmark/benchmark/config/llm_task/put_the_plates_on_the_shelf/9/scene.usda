#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Scope "Objects"
    {
        def "benchmark_plate_019_00" (
            prepend payload = @/geniesim_assets/objects/benchmark/plate/benchmark_plate_019/Aligned.usda@
        )
        {
            quatf xformOp:orient = (0.18696586249248007, 0.0, 0.0, -0.9823664335032162)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (-0.4442074312432386, 1.4059348708081223,1.05625)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "entity"
            {
            }
        }
        def "benchmark_plate_012_01" (
            prepend payload = @/geniesim_assets/objects/benchmark/plate/benchmark_plate_012/Aligned.usda@
        )
        {
            quatf xformOp:orient = (0.9904112379240686, 0.0, 0.0, 0.13815072640091244)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (-0.4549400144533477, 1.1484171497085987, 1.0637117107520737)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "entity"
            {
            }
        }
        def "benchmark_dish_rack_001" (
            prepend payload = @/geniesim_assets/objects/benchmark/dish_rack/benchmark_dish_rack_001/Aligned.usda@
        )
        {
            quatf xformOp:orient = (0.38430975682672164, 0.0, 0.0, 0.9232041896864345)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (-2.2875128730228136, 1.7953105119552792, 0.9016553190142982)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "entity"
            {
                bool physics:rigidBodyEnabled = 0

                over "Looks"
                {
                    over "ml_body"
                    {
                        over "ml_body"
                        {
                            color3f inputs:diffuse_color_constant = (0.035, 0.045, 0.055)
                            asset inputs:diffuse_texture = @@
                            float inputs:metallic_constant = 0
                            float inputs:metallic_texture_influence = 0
                            float inputs:reflection_roughness_constant = 0.48
                            float inputs:reflection_roughness_texture_influence = 0
                        }
                    }
                }
            }
        }
    }
}
