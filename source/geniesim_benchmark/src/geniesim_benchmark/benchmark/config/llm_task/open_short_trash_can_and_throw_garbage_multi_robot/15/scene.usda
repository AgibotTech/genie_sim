#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def "Objects"
    {
        def Xform "table_47e352a8" (
            prepend payload = @/geniesim_assets/objects/edited/table_000/Aligned.usda@
        )
        {
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0.365)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Xform "benchmark_trash_can__short_ecea09ff" (
            prepend payload = @/geniesim_assets/objects/benchmark/trash_can/benchmark_trash_can_015_short/Aligned.usda@
        )
        {
            quatf xformOp:orient = (0.084815, 0, 0, 0.996397)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.119, 0.001, 0.8505559511848587)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        }

        def Xform "benchmark_trash_889fbac1" (
            prepend payload = @/geniesim_assets/objects/benchmark/trash/benchmark_trash_021/Aligned.usda@
        )
        {
            quatf xformOp:orient = (0.99263245, 0, 0, 0.121164605)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (-0.11490073603715234, -0.16219615261896803, 0.7671608088266788)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "entity" (
                prepend apiSchemas = ["PhysxRigidBodyAPI"]
            )
            {
                float physics:mass = 0.03
                float physxRigidBody:maxDepenetrationVelocity = 0.2
                int physxRigidBody:solverPositionIterationCount = 64
                int physxRigidBody:solverVelocityIterationCount = 16

                over "body"
                {
                    over "visual" (
                        prepend apiSchemas = ["PhysxConvexHullCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }
            }
        }
    }
}

