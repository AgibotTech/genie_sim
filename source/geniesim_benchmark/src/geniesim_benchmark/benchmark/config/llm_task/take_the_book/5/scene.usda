#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

# take_the_book instance 5.
# Deterministic arrangement: seed 1, target benchmark_book_027.
# Layout rule: books packed left->right inside the shelf compartment (dividers
# at x=-0.241 / x=0.019, 0.002 m wall margin), gaps
# >= 0.0012 m at wrapper-bbox level (no initial interpenetration); each book
# keeps its authored resting z and the 90deg-about-Y display orientation; y is
# the authored row centre + U(-0.006, +0.006) per book.
# This workspace scene owns ALL task physics: the bookshelf (kinematic) and the
# twelve standing books. The background scene
# (scenes/take_the_book_benchmark/background.usda) is environment-only, so no
# physics body is duplicated across layers.
def Xform "World"
{
    def Scope "Objects"
    {
        def Xform "benchmark_shelf_010" (
            prepend payload = @/geniesim_assets/objects/benchmark/shelf/benchmark_shelf_010/Aligned.usda@
        )
        {
            over "entity"
            {
                bool physics:kinematicEnabled = 1
            }
            quatf xformOp:orient = (0.70710677, 0.00000000, 0.00000000, -0.70710677)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (-0.1236463272228544, 2.6222337065168997, 0.7799664283106016)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Xform "benchmark_book_028" (
            prepend payload = @/geniesim_assets/objects/benchmark/book/benchmark_book_028/Aligned.usda@
        )
        {
            quatf xformOp:orient = (0.70710677, 0.00000000, 0.70710677, 0.00000000)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (-0.2285673599095387, 2.6081282416342764, 1.0441132794274941)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "entity"
            {
                float physics:mass = 0.5
            }
        }
