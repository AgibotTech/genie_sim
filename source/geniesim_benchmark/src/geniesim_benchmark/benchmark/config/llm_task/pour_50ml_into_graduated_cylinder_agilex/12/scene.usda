                    int physxParticleIsosurface:numMeshSmoothingPasses = 4
                    float physxParticleIsosurface:surfaceDistance = 0.0018
                    bool physxParticleSmoothing:particleSmoothingEnabled = 1
                    float physxParticleSmoothing:strength = 0.5
