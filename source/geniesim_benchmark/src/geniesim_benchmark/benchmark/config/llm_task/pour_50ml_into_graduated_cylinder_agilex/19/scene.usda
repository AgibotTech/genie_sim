                    bool enableCCD = 1
                    float fluidRestOffset = 0.001
                    rel material:binding = </World/Objects/liquid/entity/Looks/OpaqueLiquid>
                    rel material:binding:physics = </World/Objects/liquid/entity/Looks/FluidPhysics> (
