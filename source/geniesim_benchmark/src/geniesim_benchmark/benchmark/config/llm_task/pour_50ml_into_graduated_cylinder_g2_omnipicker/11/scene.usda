                    float maxVelocity = 3
                    float particleContactOffset = 0.0025
                    float physxParticleIsosurface:gridSpacing = 0.0014
                    bool physxParticleIsosurface:isosurfaceEnabled = 1
                    uniform int physxParticleIsosurface:maxTriangles = 1000000
                    uniform int physxParticleIsosurface:maxVertices = 500000
                    int physxParticleIsosurface:numMeshNormalSmoothingPasses = 4
                    int physxParticleIsosurface:numMeshSmoothingPasses = 4
                    float physxParticleIsosurface:surfaceDistance = 0.0018
                    bool physxParticleSmoothing:particleSmoothingEnabled = 1
                    float physxParticleSmoothing:strength = 0.5
                    float restOffset = 0.0015
                    rel simulationOwner = </physicsScene>
