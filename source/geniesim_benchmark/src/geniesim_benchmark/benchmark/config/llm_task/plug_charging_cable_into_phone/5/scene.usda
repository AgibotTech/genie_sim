#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def "Objects"
    {
        def Xform "table_a7151455" (
            prepend payload = @/geniesim_assets/objects/edited/table_000/Aligned.usda@
        )
        {
            over "entity"
            {
                bool physics:kinematicEnabled = 1
            }
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0.365)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

