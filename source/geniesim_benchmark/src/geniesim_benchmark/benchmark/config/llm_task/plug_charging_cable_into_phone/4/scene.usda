#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def "Objects"
    {
        def Xform "table_6b509661" (
            prepend payload = @/geniesim_assets/objects/edited/table_000/Aligned.usda@
        )
        {
            over "entity"
            {
                bool physics:kinematicEnabled = 1
