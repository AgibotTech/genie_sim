        def Xform "pen_holder" (
            prepend payload = @/geniesim_assets/objects/benchmark/stationery/benchmark_stationery_021/Aligned.usda@
        )
        {
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.02, -0.1996, 0.8718060575671304)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "entity"
            {
                bool physics:kinematicEnabled = 1

                over "body"
                {
                    float3 xformOp:scale = (0.5, 1, 0.5)
                }
            }
        }

        def Xform "pen" (
            prepend payload = @/geniesim_assets/objects/benchmark/pen/benchmark_pen_009/Aligned.usda@
        )
        {
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.02, -0.1996, 0.9070046575220938)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "entity"
            {
                custom rel generatedGeometry:target = </World/Objects/Ink/strokes>
                bool physics:kinematicEnabled = 0
            }
        }

        def Xform "Ink"
        {
            custom int ink:facesEnd = 0
            custom int ink:indicesEnd = 0
            custom double3 ink:lastDrawPoint = (0, 0, 0)
            custom double ink:lastInkWidth = 0
            custom int ink:lastSurfaceAxis = 2
            custom double ink:lastSurfaceSign = 1
            custom token ink:mode = "live"
            custom int ink:pointsEnd = 0
            custom bool ink:recordable = 1
            custom int ink:revision = 0
            custom bool ink:wasTouching = 0

            def Mesh "strokes"
            {
                uniform bool doubleSided = 1
                int[] faceVertexCounts = []
                int[] faceVertexIndices = []
                point3f[] points = []
                color3f[] primvars:displayColor = [(0.005, 0.004, 0.003)]
                uniform token subdivisionScheme = "none"
            }
        }
    }

    def Scope "Looks"
    {
        def Material "OmniPBR"
        {
            token outputs:mdl:displacement.connect = </World/Looks/OmniPBR/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/OmniPBR/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/OmniPBR/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (1, 0.99999, 0.99999)
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "CopybookGray"
        {
            token outputs:surface.connect = </World/Looks/CopybookGray/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.35, 0.35)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }
}

