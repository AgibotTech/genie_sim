                        over "Release"
                        {
                            custom string inputs:script = """\"\"\"Self-contained keycap release, aligned installation, and Stop reset.\"\"\"

import math

from pxr import Gf, Sdf, Usd, UsdGeom, UsdPhysics
from geniesim_assets.behavior_lifecycle import SceneOwner


def configure_detachable_key(stage, keyboard_path, target_path):
    \"\"\"Select one releasable key through metadata, preserving all joint drives.\"\"\"
    keyboard = stage.GetPrimAtPath(keyboard_path)
    if not keyboard.IsValid():
        raise ValueError(f'Keyboard missing at {keyboard_path}')
    keys = [p for p in Usd.PrimRange(keyboard)
            if p.GetAttribute('userProperties:releaseFraction').Get() is not None]
    target = Sdf.Path(target_path)
    if not any(p.GetPath() == target for p in keys):
        raise ValueError(f'Target {target_path} is not a mechanical key in {keyboard_path}')
    for key in keys:
        key.CreateAttribute('userProperties:allowDetach', Sdf.ValueTypeNames.Bool).Set(key.GetPath() == target)


class SimulationResetState:
    \"\"\"Capture this asset's bodies and joints before Play; restore them on Stop.\"\"\"

    def __init__(self, stage, root_path):
        self.stage = stage
        self.root_path = root_path
        self.generation = 0
        self._timeline_subscription = None
        self._was_stopped = True
        self._scene_owner = SceneOwner(stage.GetPrimAtPath(root_path), self._retire)
        try:
            self.capture_initial()
        except BaseException:
            self.close()
            raise

    def capture_initial(self):
        if not self._scene_owner.current:
            return
        self._initial_attributes = []
        for prim in Usd.PrimRange(self.stage.GetPrimAtPath(self.root_path)):
            self._capture_prim(prim)

    def _capture_prim(self, prim):
        attributes = []
        if prim.HasAPI(UsdPhysics.RigidBodyAPI):
            xform = UsdGeom.Xformable(prim)
            attributes = [op.GetAttr() for op in xform.GetOrderedXformOps()]
            attributes.append(xform.GetXformOpOrderAttr())
            body = UsdPhysics.RigidBodyAPI(prim)
            attributes.extend((body.GetVelocityAttr(), body.GetAngularVelocityAttr(),
                               body.GetKinematicEnabledAttr(), body.GetRigidBodyEnabledAttr()))
        if prim.IsA(UsdPhysics.Joint):
            attributes.append(UsdPhysics.Joint(prim).GetJointEnabledAttr())
            attributes.extend(a for a in prim.GetAttributes() if a.GetName().startswith(\"drive:\")
                              and a.GetName().endswith((\":targetPosition\", \":targetVelocity\")))
        permission = prim.GetAttribute('userProperties:allowDetach')
        if permission and permission.Get() is not None:
            attributes.append(permission)
        for attr in attributes:
            value = attr.Get()
            if value is not None:
                self._initial_attributes.append((str(prim.GetPath()), attr.GetName(), attr.GetTypeName(), value))

    def restore(self):
        if not self._scene_owner.current:
            return
        self.generation += 1
        for path, name, kind, value in self._initial_attributes:
            prim = self.stage.GetPrimAtPath(path)
            if prim.IsValid():
                prim.CreateAttribute(name, kind).Set(value)
        self._after_restore()

    def _after_restore(self):
        pass

    def attach_timeline(self):
        import omni.timeline
        timeline = omni.timeline.get_timeline_interface()
        self._was_stopped = timeline.is_stopped()

        def on_event(event):
            if not self._scene_owner.current:
                return
            if event.type == int(omni.timeline.TimelineEventType.STOP):
                self.restore()
                self._was_stopped = True
            elif event.type == int(omni.timeline.TimelineEventType.PLAY) and self._was_stopped:
                self.capture_initial()
                self._after_restore()
                self._was_stopped = False

        self._timeline_subscription = timeline.get_timeline_event_stream().create_subscription_to_pop(on_event)
        return self

    def close(self):
        self._scene_owner.close()

    def _retire(self):
        self.generation += 1
        self.pending = False
        self.pending_attachment = None
        self._timeline_subscription = None


class KeycapAutoDetach(SimulationResetState):
    \"\"\"Release the original cap; keep an aligned installed replacement connected.\"\"\"

    def __init__(self, stage, key_path, joint_path=None):
        try:
            self.joint_path = joint_path or f\"{key_path}/KeyTravel\"
            super().__init__(stage, key_path)
            root = stage.GetPrimAtPath(key_path)
            self.joint = UsdPhysics.PrismaticJoint(stage.GetPrimAtPath(self.joint_path))
            if not root.IsValid() or not self.joint.GetPrim().IsValid():
                raise ValueError(f\"Mechanical key or KeyTravel joint missing at {key_path}\")
            self.base = stage.GetPrimAtPath(self.joint.GetBody0Rel().GetTargets()[0])
            self.cap = stage.GetPrimAtPath(self.joint.GetBody1Rel().GetTargets()[0])
            lower = float(self.joint.GetLowerLimitAttr().Get())
            upper = float(self.joint.GetUpperLimitAttr().Get())
            fraction = float(root.GetAttribute(\"userProperties:releaseFraction\").Get())
            if not lower < upper or not 0 < fraction <= 1:
                raise ValueError(\"Invalid travel limits or release fraction\")
            self.threshold = lower + fraction * (upper - lower)
            self.upper = upper
            self.rest = float(UsdPhysics.DriveAPI(self.joint.GetPrim(), \"linear\").GetTargetPositionAttr().Get())
            self.xy_tolerance = float(root.GetAttribute(\"userProperties:attachXYTolerance\").Get())
            self.z_tolerance = float(root.GetAttribute(\"userProperties:attachZTolerance\").Get())
            self.angle_tolerance = float(root.GetAttribute(\"userProperties:attachAngleDegrees\").Get())
            self.confirm_frames = int(root.GetAttribute(\"userProperties:attachConfirmFrames\").Get())
            self.compatibility = root.GetAttribute(\"userProperties:keycapCompatibility\").Get()
            self.detached = not bool(self.joint.GetJointEnabledAttr().Get())
            self.previous_travel = self.travel()
            self.pending = False
            self.pending_attachment = None
            self._blocked_caps = set()
            self._candidate_path = None
            self._candidate_frames = 0
        except BaseException:
            owner = getattr(self, \"_scene_owner\", None)
            if owner is not None:
                owner.close()
            raise

    def capture_initial(self):
        if not self._scene_owner.current:
            return
        super().capture_initial()
        # Replacement caps are siblings in user scenes. Preserve their initial
        # poses as well as the original joint binding for Stop after a swap.
        self._external_initial_attributes = {}
        self._installed_caps = set()
        for prim in self.stage.Traverse():
            if prim.GetAttribute(\"userProperties:keycapCompatibility\").Get() and prim.HasAPI(UsdPhysics.RigidBodyAPI):
                if not prim.GetPath().HasPrefix(self.stage.GetPrimAtPath(self.root_path).GetPath()):
                    start = len(self._initial_attributes)
                    self._capture_prim(prim)
                    self._external_initial_attributes[str(prim.GetPath())] = self._initial_attributes[start:]
                    del self._initial_attributes[start:]
        joint = UsdPhysics.Joint(self.stage.GetPrimAtPath(self.joint_path))
        self._initial_joint_targets = joint.GetBody1Rel().GetTargets()

    def restore(self):
        if not self._mechanism_current():
            return
        self.joint.GetBody1Rel().SetTargets(self._initial_joint_targets)
        self.cap = self.stage.GetPrimAtPath(self._initial_joint_targets[0])
        for path in self._installed_caps:
            for prim_path, name, kind, value in self._external_initial_attributes.get(path, []):
                prim = self.stage.GetPrimAtPath(prim_path)
                if prim.IsValid():
                    prim.CreateAttribute(name, kind).Set(value)
        super().restore()

    def _mechanism_current(self):
        return (self._scene_owner.current
                and bool(self.joint.GetPrim()) and self.joint.GetPrim().IsValid()
                and bool(self.base) and self.base.IsValid()
                and bool(self.cap) and self.cap.IsValid())

    def travel(self):
        if not self._mechanism_current():
            return 0.0
        cache = UsdGeom.XformCache()
        base_matrix = cache.GetLocalToWorldTransform(self.base)
        cap_matrix = cache.GetLocalToWorldTransform(self.cap)
        anchor0 = base_matrix.Transform(Gf.Vec3d(self.joint.GetLocalPos0Attr().Get()))
        anchor1 = cap_matrix.Transform(Gf.Vec3d(self.joint.GetLocalPos1Attr().Get()))
        axis = base_matrix.TransformDir(Gf.Vec3d(0, 0, 1)).GetNormalized()
        return Gf.Dot(anchor1 - anchor0, axis)

    def update(self, defer=False):
        if not self._mechanism_current():
            return False
        if self.pending:
            return False
        if self.detached:
            return self._update_attachment(defer)
        if not self.joint.GetJointEnabledAttr().Get():
            self.detached = True
            return False
        current = self.travel()
        crossed_up = self.previous_travel < self.threshold <= current
        self.previous_travel = current
        if not crossed_up or not self.release_allowed():
            return False
        if defer:
            self.pending = True
        else:
            self.commit_release()
        return True

    def release_allowed(self):
        if not self._mechanism_current():
            return False
        # The removable original cap and a successfully installed replacement
        # have different task contracts. Keep the replacement's travel spring,
        # but never release its binding through the original cap's threshold.
        # commit_release also checks this, covering a deferred stale callback.
        if str(self.cap.GetPath()) in self._installed_caps:
            return False
        value = self.stage.GetPrimAtPath(self.root_path).GetAttribute('userProperties:allowDetach').Get()
        return value is None or bool(value)

    def _alignment(self, cap):
        cache = UsdGeom.XformCache()
        base = cache.GetLocalToWorldTransform(self.base)
        relative = cache.GetLocalToWorldTransform(cap) * base.GetInverse()
        offset = relative.Transform(Gf.Vec3d(self.joint.GetLocalPos1Attr().Get())) - Gf.Vec3d(self.joint.GetLocalPos0Attr().Get())
        quaternion = relative.ExtractRotationQuat()
        angle = math.degrees(2 * math.acos(min(1.0, abs(float(quaternion.GetReal())))))
        return math.hypot(offset[0], offset[1]), float(offset[2]), angle

    def _eligible(self, cap):
        if not cap.IsValid() or not cap.HasAPI(UsdPhysics.RigidBodyAPI):
            return False
        if cap.GetAttribute(\"userProperties:keycapCompatibility\").Get() != self.compatibility:
            return False
        body = UsdPhysics.RigidBodyAPI(cap)
        if not body.GetRigidBodyEnabledAttr().Get() or body.GetKinematicEnabledAttr().Get():
            return False
        path = cap.GetPath()
        for prim in self.stage.Traverse():
            if prim.IsA(UsdPhysics.Joint) and prim != self.joint.GetPrim():
                joint = UsdPhysics.Joint(prim)
                if joint.GetJointEnabledAttr().Get() and path in (joint.GetBody0Rel().GetTargets() + joint.GetBody1Rel().GetTargets()):
                    return False
        xy, z, angle = self._alignment(cap)
        return xy <= self.xy_tolerance and -self.z_tolerance <= z <= self.rest + self.z_tolerance and angle <= self.angle_tolerance

    def _update_attachment(self, defer):
        if self.joint.GetJointEnabledAttr().Get():
            self.cap = self.stage.GetPrimAtPath(self.joint.GetBody1Rel().GetTargets()[0])
            self.detached = False
            self.previous_travel = self.travel()
            return False
        for path in list(self._blocked_caps):
            cap = self.stage.GetPrimAtPath(path)
            if not cap.IsValid():
                self._blocked_caps.remove(path)
            else:
                xy, z, _ = self._alignment(cap)
                if xy > 3 * self.xy_tolerance or z > self.upper + 0.001:
                    self._blocked_caps.remove(path)
        candidate = None
        for prim in self.stage.Traverse():
            path = str(prim.GetPath())
            if path not in self._blocked_caps and self._eligible(prim):
                candidate = path
                break
        if candidate != self._candidate_path:
            self._candidate_path = candidate
            self._candidate_frames = 0
        self._candidate_frames = self._candidate_frames + 1 if candidate else 0
        if self._candidate_frames < self.confirm_frames:
            return False
        self.pending_attachment = candidate
        self.pending = True
        if not defer:
            return self.commit_pending()
        return True

    def commit_pending(self, generation=None):
        \"\"\"Apply release or installation outside the PhysX step; recheck installation.\"\"\"
        if not self._mechanism_current():
            return False
        if generation is not None and (generation != self.generation or not self.pending):
            return False
        if self.pending_attachment is None:
            return self.commit_release(generation)
        cap = self.stage.GetPrimAtPath(self.pending_attachment)
        self.pending_attachment = None
        self.pending = False
        self._candidate_path = None
        self._candidate_frames = 0
        if not self.detached or self.joint.GetJointEnabledAttr().Get() or not self._eligible(cap):
            return False
        path = str(cap.GetPath())
        if path not in self._external_initial_attributes and not cap.GetPath().HasPrefix(self.base.GetPath().GetParentPath()):
            start = len(self._initial_attributes)
            self._capture_prim(cap)
            self._external_initial_attributes[path] = self._initial_attributes[start:]
            del self._initial_attributes[start:]
        self._installed_caps.add(path)
        self.joint.GetBody1Rel().SetTargets([cap.GetPath()])
        self.joint.GetJointEnabledAttr().Set(True)
        self.cap = cap
        self.detached = False
        self.previous_travel = self.travel()
        return True

    def commit_release(self, generation=None):
        \"\"\"Call from a safe app update, never inside the physics step.\"\"\"
        if not self._mechanism_current():
            return False
        if generation is not None and (generation != self.generation or not self.pending):
            return False
        if not self.joint.GetPrim().IsValid():
            self.pending = False
            return False
        if not self.release_allowed():
            self.pending = False
            self.previous_travel = self.travel()
            return False
        self.joint.GetJointEnabledAttr().Set(False)
        self.detached = True
        self._blocked_caps.add(str(self.cap.GetPath()))
        self.pending = False
        return True

    def _after_restore(self):
        if not self._mechanism_current():
            return
        self.cap = self.stage.GetPrimAtPath(self.joint.GetBody1Rel().GetTargets()[0])
        self.detached = not bool(self.joint.GetJointEnabledAttr().Get())
        self.pending = False
        self.pending_attachment = None
        self._blocked_caps = set()
        self._candidate_path = None
        self._candidate_frames = 0
        self._installed_caps = set()
        self.previous_travel = self.travel()


import asyncio
import omni.kit.app
import omni.usd
import omni.timeline
from pxr import Sdf

def compute(db):
    state = db.per_instance_state
    if not hasattr(state, \"controller\"):
        stage = omni.usd.get_context().get_stage()
        cap_path = Sdf.Path(str(db.node.get_prim_path())).GetParentPath().GetParentPath()
        cap = stage.GetPrimAtPath(cap_path)
        key_path = cap.GetRelationship(\"userProperties:keyControllerRoot\").GetTargets()[0]
        joint_path = cap.GetRelationship(\"userProperties:keyTravelJoint\").GetTargets()[0]
        state.controller = KeycapAutoDetach(stage, str(key_path), joint_path=str(joint_path)).attach_timeline()
    controller = state.controller
    if controller._scene_owner.current and omni.timeline.get_timeline_interface().is_playing() and controller.update(defer=True):
        generation = controller.generation
        async def release_next_update():
            await omni.kit.app.get_app().next_update_async()
            controller.commit_pending(generation=generation)
        asyncio.ensure_future(release_next_update())
    return True

def cleanup(db):
    controller = getattr(db.per_instance_state, \"controller\", None)
    if controller is not None:
        controller.close()
        del db.per_instance_state.controller
