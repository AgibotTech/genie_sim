                        apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/Objects/liquid/entity/Looks/OpaqueLiquid>
                        double radius = 0.001
                    }
                }

                def Scope "Looks"
                {
                    def Material "FluidPhysics" (
                        apiSchemas = ["PhysxPBDMaterialAPI"]
                    )
                    {
                        float physxPBDMaterial:adhesion = 0.01
                        float physxPBDMaterial:adhesionOffsetScale = 0
                        float physxPBDMaterial:cohesion = 200
                        float physxPBDMaterial:damping = 0
                        float physxPBDMaterial:density = 1000
                        float physxPBDMaterial:friction = 0.1
                        float physxPBDMaterial:particleAdhesionScale = 0.1
                        float physxPBDMaterial:surfaceTension = 0
                        float physxPBDMaterial:viscosity = 2500000
                    }

                    def Material "OpaqueLiquid"
                    {
                        token outputs:surface.connect = </World/Objects/liquid/entity/Looks/OpaqueLiquid/Shader.outputs:surface>

                        def Shader "Shader"
                        {
                            uniform token info:id = "UsdPreviewSurface"
                            color3f inputs:diffuseColor = (0.26, 0.1, 0.035)
                            float inputs:ior = 1.46
                            float inputs:metallic = 0
                            float inputs:opacity = 1
                            float inputs:roughness = 0.27
                            token outputs:surface
                        }
                    }
                }
            }
        }
    }
}
