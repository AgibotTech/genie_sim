<?xml version="1.0"?>
<!--
  crsB arm parameters — DEFAULT set.

  Values that historically lived inline in G2.arm.crsB.urdf.xacro:
    * per-link mass / COM origin / inertia tensor
    * per-joint velocity limit
    * per-joint <dynamics> damping and friction

  Everything else (joint kinematics, effort, position limits, meshes,
  collisions, <drive> gains) stays in G2.arm.crsB.urdf.xacro.

  The damping values are 0.0 because the <dynamics> tags carried no
  damping attribute at all before this file existed, and URDF defaults
  an absent damping to zero.  The friction values are the sim's own
  1.0/1.0/0.5/0.5/0.5/0.2/0.2 N*m, verbatim.

  Sibling file G2.arm.crsB.params.sysid.xacro carries the identified
  set; both files share this exact schema so `diff` between them shows
  only the substantive parameter drift.  Armature, which URDF cannot
  express, lives in robots/genie/g2/g2_crsB_drive_params.sysid.yaml.

  Selection: `xacro ... inertia_source:=default|sysid` (default: default).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

