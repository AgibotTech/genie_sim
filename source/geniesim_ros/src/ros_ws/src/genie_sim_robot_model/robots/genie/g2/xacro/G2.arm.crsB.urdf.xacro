<?xml version="1.0"?>
<!--
  crsB arm structure.

  Kinematics, meshes, collisions, and drive gains are the source of
  truth here.  Per-link inertials, per-joint <dynamics> damping and
  friction, and per-joint velocity limits are pulled in from a
  companion params file:

    G2.arm.crsB.params.default.xacro   (default, current sim values)
    G2.arm.crsB.params.sysid.xacro     (identified set)

  Selection is driven by the top-level `inertia_source` xacro arg
  (default: default).  See g2_crsB_*.urdf.xacro for wiring.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- main xacro -->
  <xacro:macro name="arm_l"
    params="parent_link xyz_offset rpy_offset end_link collision_type mesh_dir app">
    <!-- properties -->

    <!-- Arm -->
    <link name="arm_l_link1">
      <inertial>
        <origin xyz="${crsB_l1_com_xyz}" rpy="${crsB_l1_com_rpy}" />
        <mass value="${crsB_l1_mass}" />
        <inertia ixx="${crsB_l1_ixx}" iyy="${crsB_l1_iyy}" izz="${crsB_l1_izz}" ixy="${crsB_l1_ixy}" ixz="${crsB_l1_ixz}" iyz="${crsB_l1_iyz}" />
      </inertial>
      <visual name="default_visual">
        <geometry>
          <mesh filename="${mesh_dir}/arm/crsB/arm_l_link1.dae" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material_override>
          <roughness>0.45</roughness>
          <metallic>0.0</metallic>
        </material_override>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="arm_l_link1_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/arm_l_link1.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'coarse'}">
        <collision name="arm_l_link1_convex_0">
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/convex/arm_l_link1.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="arm_l_link1_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint name="idx21_arm_l_joint1" type="revolute">
      <origin
        xyz="${xyz_offset}"
        rpy="${rpy_offset}" />
      <parent link="${parent_link}" />
      <child link="arm_l_link1" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-3.0718"
        upper="3.0718"
        effort="108"
        velocity="${crsB_j1_vel}" />
      <dynamics damping="${crsB_l1_damping}" friction="${crsB_l1_friction}" />
      <drive stiffness="40000" damping="600" />
    </joint>
    <link name="arm_l_link2">
      <inertial>
        <origin xyz="${crsB_l2_com_xyz}" rpy="${crsB_l2_com_rpy}" />
        <mass value="${crsB_l2_mass}" />
        <inertia ixx="${crsB_l2_ixx}" iyy="${crsB_l2_iyy}" izz="${crsB_l2_izz}" ixy="${crsB_l2_ixy}" ixz="${crsB_l2_ixz}" iyz="${crsB_l2_iyz}" />
      </inertial>
      <visual name="default_visual">
        <geometry>
          <mesh filename="${mesh_dir}/arm/crsB/arm_l_link2.dae" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material_override>
          <roughness>0.62</roughness>
          <metallic>0.66</metallic>
        </material_override>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="arm_l_link2_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/arm_l_link2.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'coarse'}">
        <collision name="arm_l_link2_convex_0">
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/convex/arm_l_link2.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="arm_l_link2_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint name="idx22_arm_l_joint2" type="revolute">
      <origin
        xyz="0 0 0.1745"
        rpy="1.5708 0 0" />
      <parent link="arm_l_link1" />
      <child link="arm_l_link2" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-2.0595"
        upper="2.0595"
        effort="108"
        velocity="${crsB_j2_vel}" />
      <dynamics damping="${crsB_l2_damping}" friction="${crsB_l2_friction}" />
      <drive stiffness="40000" damping="600" />
    </joint>
    <link name="arm_l_link3">
      <inertial>
        <origin xyz="${crsB_l3_com_xyz}" rpy="${crsB_l3_com_rpy}" />
        <mass value="${crsB_l3_mass}" />
        <inertia ixx="${crsB_l3_ixx}" iyy="${crsB_l3_iyy}" izz="${crsB_l3_izz}" ixy="${crsB_l3_ixy}" ixz="${crsB_l3_ixz}" iyz="${crsB_l3_iyz}" />
      </inertial>
      <visual name="default_visual">
        <geometry>
          <mesh filename="${mesh_dir}/arm/crsB/arm_l_link3.dae" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material_override>
          <roughness>0.62</roughness>
          <metallic>0.66</metallic>
        </material_override>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="arm_l_link3_visual_0">
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/arm_l_link3.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'coarse'}">
        <collision name="arm_l_link3_convex_0">
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/convex/arm_l_link3.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="arm_l_link3_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint name="idx23_arm_l_joint3" type="revolute">
      <origin
        xyz="0 0 0"
        rpy="-1.5708 0 0" />
      <parent link="arm_l_link2" />
      <child link="arm_l_link3" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-3.0718"
        upper="3.0718"
        effort="35"
        velocity="${crsB_j3_vel}" />
      <dynamics damping="${crsB_l3_damping}" friction="${crsB_l3_friction}" />
      <drive stiffness="15000" damping="220" />
    </joint>
    <link name="arm_l_link4">
      <inertial>
        <origin xyz="${crsB_l4_com_xyz}" rpy="${crsB_l4_com_rpy}" />
        <mass value="${crsB_l4_mass}" />
        <inertia ixx="${crsB_l4_ixx}" iyy="${crsB_l4_iyy}" izz="${crsB_l4_izz}" ixy="${crsB_l4_ixy}" ixz="${crsB_l4_ixz}" iyz="${crsB_l4_iyz}" />
      </inertial>
      <visual name="default_visual">
        <geometry>
          <mesh filename="${mesh_dir}/arm/crsB/arm_l_link4.dae" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material_override>
          <roughness>0.62</roughness>
          <metallic>0.66</metallic>
        </material_override>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="arm_l_link4_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/arm_l_link4.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'coarse'}">
        <collision name="arm_l_link4_convex_0">
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/convex/arm_l_link4.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="arm_l_link4_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint name="idx24_arm_l_joint4" type="revolute">
      <origin
        xyz="0.0105 0 0.332"
        rpy="1.5708 0 0" />
      <parent link="arm_l_link3" />
      <child link="arm_l_link4" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-2.4959"
        upper="1.0123"
        effort="35"
        velocity="${crsB_j4_vel}" />
      <dynamics damping="${crsB_l4_damping}" friction="${crsB_l4_friction}" />
      <drive stiffness="15000" damping="220" />
    </joint>
    <link name="arm_l_link5">
      <inertial>
        <origin xyz="${crsB_l5_com_xyz}" rpy="${crsB_l5_com_rpy}" />
        <mass value="${crsB_l5_mass}" />
        <inertia ixx="${crsB_l5_ixx}" iyy="${crsB_l5_iyy}" izz="${crsB_l5_izz}" ixy="${crsB_l5_ixy}" ixz="${crsB_l5_ixz}" iyz="${crsB_l5_iyz}" />
      </inertial>
      <visual name="default_visual">
        <geometry>
          <mesh filename="${mesh_dir}/arm/crsB/arm_l_link5.dae" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material_override>
          <roughness>0.62</roughness>
          <metallic>0.66</metallic>
        </material_override>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="arm_l_link5_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/arm_l_link5.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'coarse'}">
        <collision name="arm_l_link5_convex_0">
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/convex/arm_l_link5.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="arm_l_link5_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint name="idx25_arm_l_joint5" type="revolute">
      <origin
        xyz="-0.0105 0 0"
        rpy="-1.5708 0 0" />
      <parent link="arm_l_link4" />
      <child link="arm_l_link5" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-3.0718"
        upper="3.0718"
        effort="35"
        velocity="${crsB_j5_vel}" />
      <dynamics damping="${crsB_l5_damping}" friction="${crsB_l5_friction}" />
      <drive stiffness="15000" damping="220" />
    </joint>
    <link name="arm_l_link6">
      <inertial>
        <origin xyz="${crsB_l6_com_xyz}" rpy="${crsB_l6_com_rpy}" />
        <mass value="${crsB_l6_mass}" />
        <inertia ixx="${crsB_l6_ixx}" iyy="${crsB_l6_iyy}" izz="${crsB_l6_izz}" ixy="${crsB_l6_ixy}" ixz="${crsB_l6_ixz}" iyz="${crsB_l6_iyz}" />
      </inertial>
      <visual name="default_visual">
        <geometry>
          <mesh filename="${mesh_dir}/arm/crsB/arm_l_link6.dae" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material_override>
          <roughness>0.45</roughness>
          <metallic>0.0</metallic>
        </material_override>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="arm_l_link6_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/arm_l_link6.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'coarse'}">
        <collision name="arm_l_link6_convex_0">
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/convex/arm_l_link6.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="arm_l_link6_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint name="idx26_arm_l_joint6" type="revolute">
      <origin
        xyz="0 0 0.278"
        rpy="1.5708 0 0" />
      <parent link="arm_l_link5" />
      <child link="arm_l_link6" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-1.0123"
        upper="1.0123"
        effort="18"
        velocity="${crsB_j6_vel}" />
      <dynamics damping="${crsB_l6_damping}" friction="${crsB_l6_friction}" />
      <drive stiffness="8000" damping="100" />
    </joint>
    <link name="arm_l_link7">
      <inertial>
        <origin xyz="${crsB_l7_com_xyz}" rpy="${crsB_l7_com_rpy}" />
        <mass value="${crsB_l7_mass}" />
        <inertia ixx="${crsB_l7_ixx}" iyy="${crsB_l7_iyy}" izz="${crsB_l7_izz}" ixy="${crsB_l7_ixy}" ixz="${crsB_l7_ixz}" iyz="${crsB_l7_iyz}" />
      </inertial>
      <visual name="default_visual">
        <geometry>
          <mesh filename="${mesh_dir}/arm/crsB/arm_l_link7.dae" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material_override>
          <roughness>0.45</roughness>
          <metallic>0.0</metallic>
        </material_override>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="arm_l_link7_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/arm_l_link7.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'coarse'}">
        <collision name="arm_l_link7_convex_0">
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/convex/arm_l_link7.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="arm_l_link7_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint name="idx27_arm_l_joint7" type="revolute">
      <origin
        xyz="0 0 0"
        rpy="1.5708 0 1.5708" />
      <parent link="arm_l_link6" />
      <child link="arm_l_link7" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-1.5359"
        upper="1.5359"
        effort="18"
        velocity="${crsB_j7_vel}" />
      <dynamics damping="${crsB_l7_damping}" friction="${crsB_l7_friction}" />
      <drive stiffness="8000" damping="100" />
    </joint>
    <link name="${end_link}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.001" />
        <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0" />
      </inertial>
    </link>
    <joint name='arm_l_end_joint' type='fixed'>
      <origin xyz="0.09 0.0 0.0" rpy="${PI} -${PI_2} 0" />
      <parent link="arm_l_link7" />
      <child link="${end_link}" />
    </joint>

  </xacro:macro>

  <!-- main xacro -->
  <xacro:macro name="arm_r"
    params="parent_link xyz_offset rpy_offset end_link collision_type mesh_dir app">
    <!-- properties -->

    <!-- Arm -->
    <link name="arm_r_link1">
      <inertial>
        <origin xyz="${crsB_r1_com_xyz}" rpy="${crsB_r1_com_rpy}" />
        <mass value="${crsB_r1_mass}" />
        <inertia ixx="${crsB_r1_ixx}" iyy="${crsB_r1_iyy}" izz="${crsB_r1_izz}" ixy="${crsB_r1_ixy}" ixz="${crsB_r1_ixz}" iyz="${crsB_r1_iyz}" />
      </inertial>
      <visual name="default_visual">
        <geometry>
          <mesh filename="${mesh_dir}/arm/crsB/arm_r_link1.dae" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material_override>
          <roughness>0.45</roughness>
          <metallic>0.0</metallic>
        </material_override>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="arm_r_link1_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/arm_r_link1.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'coarse'}">
        <collision name="arm_r_link1_convex_0">
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/convex/arm_r_link1.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="arm_r_link1_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint name="idx61_arm_r_joint1" type="revolute">
      <origin
        xyz="${xyz_offset}"
        rpy="${rpy_offset}" />
      <parent link="${parent_link}" />
      <child link="arm_r_link1" />
      <axis xyz="0 0 1" />
      <limit
        lower="-3.0718"
        upper="3.0718"
        effort="108"
        velocity="${crsB_j1_vel}" />
      <dynamics damping="${crsB_r1_damping}" friction="${crsB_r1_friction}" />
      <drive stiffness="40000" damping="600" />
    </joint>
    <link name="arm_r_link2">
      <inertial>
        <origin xyz="${crsB_r2_com_xyz}" rpy="${crsB_r2_com_rpy}" />
        <mass value="${crsB_r2_mass}" />
        <inertia ixx="${crsB_r2_ixx}" iyy="${crsB_r2_iyy}" izz="${crsB_r2_izz}" ixy="${crsB_r2_ixy}" ixz="${crsB_r2_ixz}" iyz="${crsB_r2_iyz}" />
      </inertial>
      <visual name="default_visual">
        <geometry>
          <mesh filename="${mesh_dir}/arm/crsB/arm_r_link2.dae" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material_override>
          <roughness>0.62</roughness>
          <metallic>0.66</metallic>
        </material_override>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="arm_r_link2_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/arm_r_link2.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'coarse'}">
        <collision name="arm_r_link2_convex_0">
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/convex/arm_r_link2.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="arm_r_link2_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint name="idx62_arm_r_joint2" type="revolute">
      <origin
        xyz="0 0 0.1745"
        rpy="${PI_2} 0 0" />
      <parent link="arm_r_link1" />
      <child link="arm_r_link2" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-2.0595"
        upper="2.0595"
        effort="108"
        velocity="${crsB_j2_vel}" />
      <dynamics damping="${crsB_r2_damping}" friction="${crsB_r2_friction}" />
      <drive stiffness="40000" damping="600" />
    </joint>
    <link name="arm_r_link3">
      <inertial>
        <origin xyz="${crsB_r3_com_xyz}" rpy="${crsB_r3_com_rpy}" />
        <mass value="${crsB_r3_mass}" />
        <inertia ixx="${crsB_r3_ixx}" iyy="${crsB_r3_iyy}" izz="${crsB_r3_izz}" ixy="${crsB_r3_ixy}" ixz="${crsB_r3_ixz}" iyz="${crsB_r3_iyz}" />
      </inertial>
      <visual name="default_visual">
        <geometry>
          <mesh filename="${mesh_dir}/arm/crsB/arm_r_link3.dae" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material_override>
          <roughness>0.62</roughness>
          <metallic>0.66</metallic>
        </material_override>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="arm_r_link3_visual_0">
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
