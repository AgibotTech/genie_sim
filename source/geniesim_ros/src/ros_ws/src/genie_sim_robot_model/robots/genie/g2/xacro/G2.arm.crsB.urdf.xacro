        </collision>
      </xacro:if>

      <xacro:if value="${collision_type == 'fine' or collision_type == 'coarse'}">
        <collision name="arm_r_link3_convex_0">
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/arm/crsB/convex/arm_r_link3.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="arm_r_link3_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint name="idx63_arm_r_joint3" type="revolute">
      <origin
        xyz="0 0 0"
        rpy="-${PI_2} 0 0" />
      <parent link="arm_r_link2" />
      <child link="arm_r_link3" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-3.0718"
        upper="3.0718"
        effort="35"
        velocity="${crsB_j3_vel}" />
      <dynamics damping="${crsB_r3_damping}" friction="${crsB_r3_friction}" />
      <drive stiffness="15000" damping="220" />
    </joint>
    <link name="arm_r_link4">
