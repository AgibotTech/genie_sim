<?xml version="1.0"?>
<!--
  X5A arm drive/passive parameters — SYSID set.

  The LEFT-arm values from the AC one identification run, transplanted
  onto the single-arm X5A, taken from its accepted model's joints
  arm_l_joint1..6.  Numerically identical to the left-arm half of
  AC1.params.sysid.xacro.

  Why the left arm and not the right: only the left side got a full
  fitted set.  On the right, the run fitted kp alone and left damping,
  frictionloss, armature and kd at the stock baseline, so there is no
  complete right-arm set to transplant.  All five families here are
  axis-sign-invariant scalars, so X5A's opposite J3/J4/J5 axis
  convention does not affect them.

  The hardware is the same arm — AC1.urdf.xacro and X5A.urdf.xacro
  agree on every link mass, joint limit and effort, so the transplant
  is between identical kinematics, not merely similar ones.

  Every caveat in AC1.params.sysid.xacro applies here, in particular:
    * these are effective closed-loop position-response parameters,
      not identified rigid-body dynamics;
    * ~90% of the reported tracking gain came from the command delay
      (0.085 s on the left arm), which is NOT in this file and has no
      home in the engine yet;
    * l1 armature 0.241 (24x stock), l3 damping 1.80 and l4
      frictionloss 0.525 sit at their search-box edges;
    * runtime preservation requires robot.joint_overlays alongside this
      xacro selector; the compatible bringup scene selects it by default.

  Selection: `xacro ... param_source:=sysid`.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- joint1 -->
  <xacro:property name="x5a_j1_damping"         value="0.02646" />
  <xacro:property name="x5a_j1_friction"        value="0.00102394" />
  <xacro:property name="x5a_j1_drive_stiffness" value="515.513" />
  <xacro:property name="x5a_j1_drive_damping"   value="1.33108" />
  <xacro:property name="x5a_j1_armature"        value="0.241167" />

  <!-- joint2 -->
  <xacro:property name="x5a_j2_damping"         value="0.0238303" />
  <xacro:property name="x5a_j2_friction"        value="0.00102044" />
  <xacro:property name="x5a_j2_drive_stiffness" value="526.311" />
  <xacro:property name="x5a_j2_drive_damping"   value="2.97626" />
  <xacro:property name="x5a_j2_armature"        value="0.0453454" />

  <!-- joint3 -->
  <xacro:property name="x5a_j3_damping"         value="1.79972" />
  <xacro:property name="x5a_j3_friction"        value="0.0142011" />
  <xacro:property name="x5a_j3_drive_stiffness" value="507.589" />
  <xacro:property name="x5a_j3_drive_damping"   value="6.85319" />
  <xacro:property name="x5a_j3_armature"        value="0.0472377" />

  <!-- joint4 -->
  <xacro:property name="x5a_j4_damping"         value="0.0101474" />
  <xacro:property name="x5a_j4_friction"        value="0.525452" />
  <xacro:property name="x5a_j4_drive_stiffness" value="324.788" />
  <xacro:property name="x5a_j4_drive_damping"   value="1.0962" />
  <xacro:property name="x5a_j4_armature"        value="0.0148545" />

  <!-- joint5 -->
  <xacro:property name="x5a_j5_damping"         value="0.762774" />
  <xacro:property name="x5a_j5_friction"        value="0.292917" />
  <xacro:property name="x5a_j5_drive_stiffness" value="508.681" />
  <xacro:property name="x5a_j5_drive_damping"   value="4.60003" />
  <xacro:property name="x5a_j5_armature"        value="0.0979814" />

  <!-- joint6 -->
  <xacro:property name="x5a_j6_damping"         value="0.527118" />
  <xacro:property name="x5a_j6_friction"        value="0.278988" />
  <xacro:property name="x5a_j6_drive_stiffness" value="57.2908" />
  <xacro:property name="x5a_j6_drive_damping"   value="3.58765" />
  <xacro:property name="x5a_j6_armature"        value="0.00416896" />

</robot>
