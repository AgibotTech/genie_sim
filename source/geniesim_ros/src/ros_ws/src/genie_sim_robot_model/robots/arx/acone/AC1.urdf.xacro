  <link name="arm_r_link2">
    <inertial>
      <origin xyz="-0.13234 -0.0040166 0.00010941" rpy="0 0 0" />
      <mass value="1.1068" />
      <inertia ixx="0.00054" ixy="0.00000" ixz="0.00004" iyy="0.01653" iyz="0.00000" izz="0.01655" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_r_link2.obj" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_r_link2.obj" /></geometry>
    </collision>
  </link>
  <joint name="arm_r_joint2" type="revolute">
    <origin xyz="0.02 0 0.04" rpy="0 0 0" />
    <parent link="arm_r_link1" />
    <child link="arm_r_link2" />
    <axis xyz="0 1 0" />
    <limit lower="-0.05" upper="3.5" effort="40" velocity="5.0" />
    <dynamics damping="${acone_r2_damping}" friction="${acone_r2_friction}" />
    <drive stiffness="${acone_r2_drive_stiffness}" damping="${acone_r2_drive_damping}" />
  </joint>

  <link name="arm_r_link3">
    <inertial>
      <origin xyz="0.18544 -0.00071369 0.051628" rpy="0 0 0" />
      <mass value="0.54316" />
      <inertia ixx="0.00036" ixy="-0.00003" ixz="-0.00039" iyy="0.00423" iyz="-0.00001" izz="0.00419" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_r_link3.obj" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_r_link3.obj" /></geometry>
    </collision>
  </link>
  <joint name="arm_r_joint3" type="revolute">
    <origin xyz="-0.264 3E-05 0" rpy="0 0 0" />
    <parent link="arm_r_link2" />
    <child link="arm_r_link3" />
    <axis xyz="0 -1 0" />
    <limit lower="-0.1" upper="3.2" effort="30" velocity="5.5" />
    <dynamics damping="${acone_r3_damping}" friction="${acone_r3_friction}" />
    <drive stiffness="${acone_r3_drive_stiffness}" damping="${acone_r3_drive_damping}" />
  </joint>

  <link name="arm_r_link4">
    <inertial>
      <origin xyz="0.039966 -0.0043045 0.035006" rpy="0 0 0" />
      <mass value="0.11827" />
      <inertia ixx="0.00019" ixy="-0.00002" ixz="-0.00009" iyy="0.00023" iyz="-0.00002" izz="0.00014" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_r_link4.obj" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_r_link4.obj" /></geometry>
    </collision>
  </link>
  <joint name="arm_r_joint4" type="revolute">
    <origin xyz="0.245 -3E-05 0.056" rpy="0 0 0" />
    <parent link="arm_r_link3" />
    <child link="arm_r_link4" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.6" upper="1.55" effort="15" velocity="5.5" />
    <dynamics damping="${acone_r4_damping}" friction="${acone_r4_friction}" />
    <drive stiffness="${acone_r4_drive_stiffness}" damping="${acone_r4_drive_damping}" />
  </joint>

  <link name="arm_r_link5">
    <inertial>
      <origin xyz="0.0029491 8.4086E-05 -0.054795" rpy="0 0 0" />
      <mass value="0.67398" />
      <inertia ixx="0.00093" ixy="0.00000" ixz="0.00005" iyy="0.00092" iyz="0.00000" izz="0.00028" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_r_link5.obj" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_r_link5.obj" /></geometry>
    </collision>
  </link>
  <joint name="arm_r_joint5" type="revolute">
    <origin xyz="0.06775 0 0.0845" rpy="0 0 0" />
    <parent link="arm_r_link4" />
    <child link="arm_r_link5" />
    <axis xyz="0 0 -1" />
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5.0" />
    <dynamics damping="${acone_r5_damping}" friction="${acone_r5_friction}" />
    <drive stiffness="${acone_r5_drive_stiffness}" damping="${acone_r5_drive_damping}" />
  </joint>

  <link name="arm_r_link6">
    <inertial>
      <origin xyz="0.040212 3.4542E-05 -0.010225" rpy="0 0 0" />
      <mass value="0.34667" />
