<?xml version="1.0"?>
<!--
  ARX AC one (dual-arm) robot description.

  Adapted from src/external/ARX_Model/AC one/URDF/AC one/acone/urdf/acone.urdf
  with mesh paths rewritten to
  package://genie_sim_robot_model/robots/arx/acone/meshes/.

  Conventions (diverging from the SolidWorks export):
    - Links/joints renamed from left_*/right_*(11..18) to arm_l_*(1..8) /
      arm_r_*(1..8) so both arms share a single 1..8 numbering and the
      prefix is the only side disambiguator.
    - Joint limits, efforts and velocities aligned with the ARX X5 SDK
      (RobotConfigFactory.get_config('X5')). Both arms are mechanically
      the same 6-DOF X5 arm.
    - Parallel gripper: joint8 mimics joint7 with multiplier=1 so each
      gripper is driven by a single DOF.
    - After arm_*_link6: arm_*_end_link and gripper_*_base_link (identity
      fixed joints) so camera paths like /G2/gripper_*_base_link/... match
      other robot descriptions.
-->
<robot name="acone"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="mesh_dir" value="package://genie_sim_robot_model/robots/arx/acone/meshes" />

  <!-- Drive / passive joint parameters. `default` is the ARX stock set;
       `sysid` is the set identified against ARX Real hardware. Both are pure
       data files with the same property names - see their headers, and note
       that the engine currently overwrites these per joint class at
       runtime. Selection: `xacro ... param_source:=sysid`. -->
  <xacro:arg name="param_source" default="default" />
  <!-- Which gripper this arm carries. Defaults to the vendored
       gripper; ``no_gripper`` omits its links/joints entirely. -->
  <xacro:arg name="gripper" default="acone" />
  <xacro:include filename="$(find genie_sim_robot_model)/robots/arx/acone/AC1.params.$(arg param_source).xacro" />

  <!-- base_link is intentionally an empty link so it can serve as the KDL
       root: kdl_parser rejects a root link that carries inertia. The
       visual / collision / inertial payload is moved to base_link_inertia,
       a child of base_link via an identity-transform fixed joint. Both
       arm chains (arm_l_joint1, arm_r_joint1, ...) still hang off
       base_link, so no downstream link/joint names change.

       The 1mm guide-sphere <visual> below flips the Isaac Sim 6.2
       URDF→USD converter's is_ghost_link check to False so it authors
       body0=parent_link on every joint. See
       genie_sim_robot_model/AGENTS.md → "Non-ghost root link pattern". -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.001"/></geometry>
    </visual>
  </link>
  <link name="base_link_inertia">
    <inertial>
      <origin xyz="0.0040185 3.8157E-05 -0.024465" rpy="0 0 0" />
      <mass value="5.6137" />
      <inertia ixx="0.21931" ixy="0.00000" ixz="-0.00199" iyy="0.02598" iyz="0.00000" izz="0.20840" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/base_link.obj" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/base_link.obj" /></geometry>
    </collision>
  </link>
  <joint name="base_link-base_link_inertia" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="base_link_inertia" />
  </joint>

  <!-- ============================ LEFT ARM ============================ -->

  <link name="arm_l_link1">
    <inertial>
      <origin xyz="0.0054231 -0.0080289 0.017086" rpy="0 0 0" />
      <mass value="0.066982" />
      <inertia ixx="0.00008" ixy="0.00000" ixz="-0.00001" iyy="0.00003" iyz="0.00000" izz="0.00008" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_l_link1.obj" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_l_link1.obj" /></geometry>
    </collision>
  </link>
  <joint name="arm_l_joint1" type="revolute">
    <origin xyz="-0.01602 0.25 0.0215" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="arm_l_link1" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="2.618" effort="30" velocity="5.0" />
    <dynamics damping="${acone_l1_damping}" friction="${acone_l1_friction}" />
    <drive stiffness="${acone_l1_drive_stiffness}" damping="${acone_l1_drive_damping}" />
  </joint>

  <link name="arm_l_link2">
    <inertial>
      <origin xyz="-0.13234 -0.0040166 0.00010941" rpy="0 0 0" />
      <mass value="1.1068" />
      <inertia ixx="0.00054" ixy="0.00000" ixz="0.00004" iyy="0.01653" iyz="0.00000" izz="0.01655" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_l_link2.obj" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_l_link2.obj" /></geometry>
    </collision>
  </link>
  <joint name="arm_l_joint2" type="revolute">
    <origin xyz="0.02 0 0.04" rpy="0 0 0" />
    <parent link="arm_l_link1" />
    <child link="arm_l_link2" />
    <axis xyz="0 1 0" />
    <limit lower="-0.05" upper="3.5" effort="40" velocity="5.0" />
    <dynamics damping="${acone_l2_damping}" friction="${acone_l2_friction}" />
    <drive stiffness="${acone_l2_drive_stiffness}" damping="${acone_l2_drive_damping}" />
  </joint>

  <link name="arm_l_link3">
    <inertial>
      <origin xyz="0.18544 -0.00071369 0.051628" rpy="0 0 0" />
      <mass value="0.54316" />
      <inertia ixx="0.00036" ixy="-0.00003" ixz="-0.00039" iyy="0.00423" iyz="-0.00001" izz="0.00419" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_l_link3.obj" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_l_link3.obj" /></geometry>
    </collision>
  </link>
  <joint name="arm_l_joint3" type="revolute">
    <origin xyz="-0.264 3E-05 0" rpy="0 0 0" />
    <parent link="arm_l_link2" />
    <child link="arm_l_link3" />
    <axis xyz="0 -1 0" />
    <limit lower="-0.1" upper="3.2" effort="30" velocity="5.5" />
    <dynamics damping="${acone_l3_damping}" friction="${acone_l3_friction}" />
    <drive stiffness="${acone_l3_drive_stiffness}" damping="${acone_l3_drive_damping}" />
  </joint>

  <link name="arm_l_link4">
    <inertial>
      <origin xyz="0.039966 -0.0043045 0.035006" rpy="0 0 0" />
      <mass value="0.11827" />
      <inertia ixx="0.00019" ixy="-0.00002" ixz="-0.00009" iyy="0.00023" iyz="-0.00002" izz="0.00014" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_l_link4.obj" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_l_link4.obj" /></geometry>
    </collision>
  </link>
  <joint name="arm_l_joint4" type="revolute">
    <origin xyz="0.245 -3E-05 0.056" rpy="0 0 0" />
    <parent link="arm_l_link3" />
    <child link="arm_l_link4" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.6" upper="1.55" effort="15" velocity="5.5" />
    <dynamics damping="${acone_l4_damping}" friction="${acone_l4_friction}" />
    <drive stiffness="${acone_l4_drive_stiffness}" damping="${acone_l4_drive_damping}" />
  </joint>

  <link name="arm_l_link5">
    <inertial>
      <origin xyz="0.0029491 8.4086E-05 -0.054795" rpy="0 0 0" />
      <mass value="0.67398" />
      <inertia ixx="0.00093" ixy="0.00000" ixz="0.00005" iyy="0.00092" iyz="0.00000" izz="0.00028" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_l_link5.obj" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_l_link5.obj" /></geometry>
    </collision>
  </link>
  <joint name="arm_l_joint5" type="revolute">
    <origin xyz="0.06775 0 0.0845" rpy="0 0 0" />
    <parent link="arm_l_link4" />
    <child link="arm_l_link5" />
    <axis xyz="0 0 -1" />
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5.0" />
    <dynamics damping="${acone_l5_damping}" friction="${acone_l5_friction}" />
    <drive stiffness="${acone_l5_drive_stiffness}" damping="${acone_l5_drive_damping}" />
  </joint>

  <link name="arm_l_link6">
    <inertial>
      <origin xyz="0.040212 3.4542E-05 -0.010225" rpy="0 0 0" />
      <mass value="0.34667" />
      <inertia ixx="0.00047" ixy="0.00000" ixz="-0.00003" iyy="0.00049" iyz="-0.00003" izz="0.00018" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_l_link6.obj" /></geometry>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_l_link6_1.obj" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_l_link6.obj" /></geometry>
    </collision>
  </link>
  <joint name="arm_l_joint6" type="revolute">
    <origin xyz="0.02895 0 -0.0845" rpy="0 0 0" />
    <parent link="arm_l_link5" />
    <child link="arm_l_link6" />
    <axis xyz="1 0 0" />
    <limit lower="-2.0" upper="2.0" effort="10" velocity="5.0" />
    <dynamics damping="${acone_l6_damping}" friction="${acone_l6_friction}" />
    <drive stiffness="${acone_l6_drive_stiffness}" damping="${acone_l6_drive_damping}" />
  </joint>

  <link name="arm_l_end_link">
  </link>
  <joint name="arm_l_end_fixed" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="arm_l_link6" />
    <child link="arm_l_end_link" />
  </joint>

  <link name="tool0_l">
  </link>
  <joint name="tool0_l_fixed" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="arm_l_end_link" />
    <child link="tool0_l" />
  </joint>

  <link name="tool0_r">
  </link>
  <joint name="tool0_r_fixed" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="arm_r_end_link" />
    <child link="tool0_r" />
  </joint>

  <xacro:unless value="${'$(arg gripper)' == 'no_gripper'}">

    <link name="gripper_l_passive_link">
      <inertial>
        <origin xyz="-0.0060354 -0.015602 0.013499" rpy="0 0 0" />
        <mass value="0.08924" />
        <inertia ixx="0.00010" ixy="0.00000" ixz="0.00001" iyy="0.00009" iyz="0.00001" izz="0.00007" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/gripper_l_passive_link.obj" /></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/convex/gripper_l_passive_link_collider_01.STL" /></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/convex/gripper_l_passive_link_collider_02.STL" /></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/convex/gripper_l_passive_link_collider_03.STL" /></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/convex/gripper_l_passive_link_collider_04.STL" /></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/convex/gripper_l_passive_link_collider_05.STL" /></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/convex/gripper_l_passive_link_collider_06.STL" /></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/convex/gripper_l_passive_link_collider_07.STL" /></geometry>
      </collision>
    </link>
    <joint name="gripper_l_passive_joint" type="prismatic">
      <origin xyz="0.08397 0.02721 -0.0062702" rpy="0 0 0" />
      <parent link="tool0_l" />
      <child link="gripper_l_passive_link" />
      <axis xyz="0 1 0" />
      <limit lower="0" upper="0.044" effort="10" velocity="1.5" />
      <mimic joint="gripper_l_active_joint" multiplier="1" offset="0" />
    </joint>

    <link name="gripper_l_active_link">
      <inertial>
        <origin xyz="-0.00581 0.015593 -0.012255" rpy="0 0 0" />
        <mass value="0.089402" />
        <inertia ixx="0.00007" ixy="0.00000" ixz="-0.00002" iyy="0.00006" iyz="0.00000" izz="0.00007" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/gripper_l_active_link.obj" /></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/convex/gripper_l_active_link_collider_01.STL" /></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/convex/gripper_l_active_link_collider_02.STL" /></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/convex/gripper_l_active_link_collider_03.STL" /></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/convex/gripper_l_active_link_collider_04.STL" /></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/convex/gripper_l_active_link_collider_05.STL" /></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/convex/gripper_l_active_link_collider_06.STL" /></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh_dir}/convex/gripper_l_active_link_collider_07.STL" /></geometry>
      </collision>
    </link>
    <joint name="gripper_l_active_joint" type="prismatic">
      <origin xyz="0.08397 -0.023638 -0.0062703" rpy="0 0 0" />
      <parent link="tool0_l" />
      <child link="gripper_l_active_link" />
      <axis xyz="0 -1 0" />
      <limit lower="0" upper="0.044" effort="10" velocity="0.3" />
    </joint>

    <!-- ============================ RIGHT ARM ============================ -->
  </xacro:unless>

  <link name="arm_r_link1">
    <inertial>
      <origin xyz="0.0054231 -0.0080289 0.017086" rpy="0 0 0" />
      <mass value="0.066982" />
      <inertia ixx="0.00008" ixy="0.00000" ixz="-0.00001" iyy="0.00003" iyz="0.00000" izz="0.00008" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_r_link1.obj" /></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="${mesh_dir}/arm_r_link1.obj" /></geometry>
    </collision>
  </link>
  <joint name="arm_r_joint1" type="revolute">
    <origin xyz="-0.01602 -0.25 0.0215" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="arm_r_link1" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="2.618" effort="30" velocity="5.0" />
    <dynamics damping="${acone_r1_damping}" friction="${acone_r1_friction}" />
    <drive stiffness="${acone_r1_drive_stiffness}" damping="${acone_r1_drive_damping}" />
