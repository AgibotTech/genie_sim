<?xml version="1.0"?>
<!--
  X5A arm drive/passive parameters — DEFAULT set.

  The ARX stock values, identical to AC1.params.default.xacro (the AC
  one arm and the X5A arm are the same hardware — link masses, joint
  limits and <limit effort> values match one-for-one between
  AC1.urdf.xacro and X5A.urdf.xacro; only the mount frame differs, and
  X5A uses the opposite axis-sign convention on J3/J4/J5).

  Per joint:
    J1-J3   kp 500  kd 5   damping 1.0  frictionloss 0.3  armature 0.01
    J4-J6   kp 350  kd 2   damping 0.5  frictionloss 0.3  armature 0.01

  `armature` has no URDF representation and is defined here only for
  the YAML sidecar (robots/arx/arx_drive_params.sysid.yaml); nothing in
  the xacro output carries it.

  IMPORTANT — inert at runtime.  The mjwarp adapter drives every DOF
  from the per-class table in physics_params.yaml; X5A's six joints
  resolve to arm_shoulder (J1-J2) / arm_mid (J3-J5) / arm_wrist (J6).
  See AC1.params.default.xacro for the full note.

  Selection: `xacro ... param_source:=default` (the default).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- joint1 -->
  <xacro:property name="x5a_j1_damping"         value="1.0" />
  <xacro:property name="x5a_j1_friction"        value="0.3" />
  <xacro:property name="x5a_j1_drive_stiffness" value="500" />
  <xacro:property name="x5a_j1_drive_damping"   value="5" />
  <xacro:property name="x5a_j1_armature"        value="0.01" />

  <!-- joint2 -->
  <xacro:property name="x5a_j2_damping"         value="1.0" />
  <xacro:property name="x5a_j2_friction"        value="0.3" />
  <xacro:property name="x5a_j2_drive_stiffness" value="500" />
  <xacro:property name="x5a_j2_drive_damping"   value="5" />
  <xacro:property name="x5a_j2_armature"        value="0.01" />

  <!-- joint3 -->
  <xacro:property name="x5a_j3_damping"         value="1.0" />
  <xacro:property name="x5a_j3_friction"        value="0.3" />
  <xacro:property name="x5a_j3_drive_stiffness" value="500" />
  <xacro:property name="x5a_j3_drive_damping"   value="5" />
  <xacro:property name="x5a_j3_armature"        value="0.01" />

  <!-- joint4 -->
  <xacro:property name="x5a_j4_damping"         value="0.5" />
  <xacro:property name="x5a_j4_friction"        value="0.3" />
  <xacro:property name="x5a_j4_drive_stiffness" value="350" />
  <xacro:property name="x5a_j4_drive_damping"   value="2" />
  <xacro:property name="x5a_j4_armature"        value="0.01" />

  <!-- joint5 -->
  <xacro:property name="x5a_j5_damping"         value="0.5" />
  <xacro:property name="x5a_j5_friction"        value="0.3" />
  <xacro:property name="x5a_j5_drive_stiffness" value="350" />
  <xacro:property name="x5a_j5_drive_damping"   value="2" />
  <xacro:property name="x5a_j5_armature"        value="0.01" />

  <!-- joint6 -->
  <xacro:property name="x5a_j6_damping"         value="0.5" />
  <xacro:property name="x5a_j6_friction"        value="0.3" />
  <xacro:property name="x5a_j6_drive_stiffness" value="350" />
  <xacro:property name="x5a_j6_drive_damping"   value="2" />
  <xacro:property name="x5a_j6_armature"        value="0.01" />

</robot>
