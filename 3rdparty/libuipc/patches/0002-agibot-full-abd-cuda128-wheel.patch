+                    TRY_PARSE(accept_special_decltype(), return true);
+                    TRY_TOK(coawait, tokenizer.accept({token_type::identifier, "co_await"}));
+                    if(coawait) {
+                        append_output(coawait.unwrap());
+                        return true;
+                    }
