+                 const std::type_info* throw_type,
+                 void** throw_obj,
+                 unsigned outer
+             ) {
+                 maybe_collect_trace(&typeid(T), throw_type, throw_obj, outer);
+                 return false;
+             }
+         };
+         CPPTRACE_EXPORT void do_prepare_unwind_interceptor(
+             const std::type_info&,
+             bool(*)(const std::type_info*, const std::type_info*, void**, unsigned)
