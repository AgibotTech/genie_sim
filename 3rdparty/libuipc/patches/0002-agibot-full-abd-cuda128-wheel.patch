+++ b/tools/wheel_cuda128/device_link.py
@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+# Genie Sim Team contributions: CUDA 12.8 wheel build and packaging support.
+# This notice covers our additions and modifications, not pre-existing
+# libuipc, NVIDIA, Eigen, or vendored third-party code.
+# Copyright (c) 2023-2026, AgiBot Inc. All Rights Reserved.
+# Author: Genie Sim Team
+# License: Mozilla Public License Version 2.0
+# SPDX-License-Identifier: MPL-2.0
+#
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+"""Run the existing CMake nvcc device-link command without local -L metadata.
+
+Usage: python3 device_link.py /path/to/nvcc <original device-link arguments>
+Only device linking is supported. Host linking and all input archives stay intact.
+CUDA 13 records -L paths in .note.nv.tkinfo inside its output fatbin. Suppress
+the nvcc profile's implicit -L paths and resolve -l names to explicit files.
+nvlink ignores shared libraries; do not substitute their static variants.
+"""
+
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+def rewrite(nvcc, arguments):
+    if not any(a in ('-dlink', '--device-link') for a in arguments):
+        raise ValueError('wrapper accepts only nvcc -dlink commands')
+    toolchain = Path(nvcc).resolve().parent.parent
+    host_compiler = 'g++'
+    search_dirs = []
+    retained = []
+    runtime_mode = 'static'
+    index = 0
+    while index < len(arguments):
+        arg = arguments[index]
+        if arg.startswith('@') or arg in ('--options-file', '-optf') or arg.startswith(('--options-file=', '-optf=')):
+            raise ValueError('response/options files must be expanded before calling this wrapper')
+        if arg in ('-ccbin', '--compiler-bindir'):
+            host_compiler = arguments[index + 1]
+            retained.extend(arguments[index:index + 2])
+            index += 2
+            continue
+        if arg.startswith(('-ccbin=', '--compiler-bindir=')):
+            host_compiler = arg.split('=', 1)[1]
+        if arg in ('-L', '--library-path'):
+            search_dirs.extend(Path(x).absolute() for x in arguments[index + 1].split(','))
+            index += 2
+            continue
+        if arg.startswith('--library-path='):
+            search_dirs.extend(Path(x).absolute() for x in arg.split('=', 1)[1].split(','))
+            index += 1
+            continue
+        if arg.startswith('-L'):
+            value = arg[2:].lstrip('=')
+            search_dirs.extend(Path(x).absolute() for x in value.split(','))
+            index += 1
+            continue
+        if arg in ('-cudadevrt', '--cudadevrt'):
+            runtime_mode = arguments[index + 1]
+            index += 2
+            continue
+        if arg.startswith(('-cudadevrt=', '--cudadevrt=')):
+            runtime_mode = arg.split('=', 1)[1]
+            index += 1
+            continue
+        if arg not in ('-noprof', '--dont-use-profile'):
+            retained.append(arg)
+        index += 1
+    if runtime_mode not in ('none', 'static'):
+        raise ValueError('unsupported cudadevrt mode: ' + runtime_mode)
+    if Path(host_compiler).is_dir():
+        host_compiler = str(Path(host_compiler) / 'g++')
+    search_dirs += [toolchain / 'lib64/stubs', toolchain / 'lib64']
+    compiler_search = subprocess.run([host_compiler, '-print-search-dirs'], text=True, capture_output=True, check=True)
+    for line in compiler_search.stdout.splitlines():
+        if line.startswith('libraries: ='):
+            search_dirs.extend(Path(x).absolute() for x in line.split('=', 1)[1].split(':') if x)
+
+    def resolve_library(name):
+        if name.startswith(':'):
+            filenames = [name[1:]]
+        else:
+            filenames = ['lib' + name + '.so', 'lib' + name + '.a']
+        # CUDA 13 nvlink checks .so across the search path before checking .a.
+        # Confirmed with a device definition in .a and a later-directory .so.
+        for filename in filenames:
+            for directory in search_dirs:
+                candidate = directory / filename
+                if candidate.is_file():
+                    return str(candidate.absolute())
+        raise ValueError('cannot resolve library -l' + name + ' in original/toolchain/compiler search paths')
+
+    rewritten = []
+    resolutions = []
+    index = 0
+    # These nvcc options begin with -l but are not library references.
+    non_libraries = {'-link', '-lib', '-lto', '-lineinfo', '-ldir'}
+    while index < len(retained):
+        arg = retained[index]
+        names = None
+        if arg in ('-l', '--library'):
+            names = retained[index + 1].split(',')
+            index += 2
+        elif arg.startswith('--library='):
+            names = arg.split('=', 1)[1].split(',')
+            index += 1
+        elif arg.startswith('-l') and arg not in non_libraries and not arg.startswith('-ldir='):
+            names = arg[2:].lstrip('=').split(',')
+            index += 1
+        else:
+            rewritten.append(arg)
+            index += 1
+        if names is not None:
+            for name in names:
+                resolved = resolve_library(name)
+                resolutions.append({'library': name, 'file': resolved})
+                rewritten.append(resolved)
+    if runtime_mode == 'static' and not any(Path(a).name == 'libcudadevrt.a' for a in rewritten):
+        rewritten.append(resolve_library('cudadevrt'))
+    command = [str(nvcc), '-noprof', '-cudadevrt=none', '-I' + str(toolchain / 'include'), *rewritten]
+    environment = os.environ.copy()
+    environment['PATH'] = str(toolchain / 'bin') + ':' + str(toolchain / 'nvvm/bin') + ':' + environment.get('PATH', '')
+    environment['NVVMIR_LIBRARY_DIR'] = str(toolchain / 'nvvm/libdevice')
+    return command, environment, resolutions
+
+
+def main():
+    if len(sys.argv) < 3:
+        raise ValueError(__doc__.splitlines()[2])
+    command, environment, resolutions = rewrite(sys.argv[1], sys.argv[2:])
+    audit = environment.get('UIPC_DEVICE_LINK_AUDIT')
+    if audit:
+        Path(audit).write_text(json.dumps({'command': command, 'resolutions': resolutions}, indent=2) + '\n')
+    return subprocess.run(command, env=environment).returncode
+
+
+if __name__ == '__main__':
+    try:
+        sys.exit(main())
+    except (ValueError, OSError, subprocess.CalledProcessError) as error:
+        print('device_link.py: ' + str(error), file=sys.stderr)
+        sys.exit(2)
