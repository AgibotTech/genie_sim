+                    return false;
+                }
+                return false;
+            } (tokenizer);
+            if(res.is_error()) {
+                return false;
+            }
+            return res.unwrap_value();
+        }
+
+        NODISCARD Result<bool, parse_error> parse_function_pointer() {
+            ASSERT(lookahead_is_function_pointer());
