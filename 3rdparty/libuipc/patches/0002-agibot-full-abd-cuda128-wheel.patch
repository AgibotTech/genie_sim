+"""Collect original component license texts for a locally built wheel.
+
+No component is relicensed by this collector. It does not claim that copying
+license notices alone supplies every material needed for binary redistribution.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+import shutil
+
+
+def license_inputs(source: Path, dependency_prefix: Path):
+    tools = source / 'tools/wheel_cuda128'
+    inputs = [
+        (source / 'LICENSE', 'upstream-libuipc-Apache-2.0.txt', 'upstream/LICENSE'),
+        (source / 'python/LICENSE', 'upstream-python-GPL-3.0.txt', 'upstream/python/LICENSE'),
+        (tools / 'LICENSES/MPL-2.0.txt', 'MPL-2.0.txt', 'wheel-recipe/LICENSES/MPL-2.0.txt'),
+        (tools / 'NOTICE', 'Genie-Sim-Team-NOTICE.txt', 'wheel-recipe/NOTICE'),
+        (tools / 'vendor/cpptrace-1.0.2/LICENSE', 'cpptrace-MIT.txt', 'vendor/cpptrace-1.0.2/LICENSE'),
+        (tools / 'vendor/urdfdom-3.1.1/LICENSE', 'urdfdom-BSD.txt', 'vendor/urdfdom-3.1.1/LICENSE'),
+        (source / 'external/GKlib/LICENSE.txt', 'GKlib-LICENSE.txt', 'upstream/external/GKlib/LICENSE.txt'),
+        (source / 'external/METIS/LICENSE', 'METIS-LICENSE.txt', 'upstream/external/METIS/LICENSE'),
+        (source / 'src/geometry/graph_coloring/LICENSE.md', 'graph-coloring-LICENSE.md', 'upstream/src/geometry/graph_coloring/LICENSE.md'),
+        (source / 'src/backends/cuda/utils/fixed_bank_soa_evd.h',
+         'covered-source/fixed_bank_soa_evd.h', 'source/src/backends/cuda/utils/fixed_bank_soa_evd.h'),
+        (source / 'src/backends/cuda/dytopo_effect_system/global_dytopo_effect_manager.cu',
+         'covered-source/global_dytopo_effect_manager.cu', 'source/src/backends/cuda/dytopo_effect_system/global_dytopo_effect_manager.cu'),
+    ]
+    # Include the Full ABD files carrying the AgiBot contribution notice.
+    for relative in (
+        'src/backends/cuda/affine_body/abd_diag_preconditioner.cu',
+        'src/backends/cuda/linear_system/fused_pcg_kernels.cu',
+        'src/backends/cuda/linear_system/fused_pcg_kernels.h',
+        'src/backends/cuda/linear_system/linear_fused_pcg.cu',
+        'src/backends/cuda/linear_system/linear_fused_pcg.h',
+        'src/core/core/scene_default_config.cpp',
+    ):
+        inputs.append((source / relative, 'covered-source/' + relative, 'source/' + relative))
+    required = [source / 'NOTICE', tools / 'DISTRIBUTION-LICENSE.txt',
+                tools / 'THIRD_PARTY_NOTICES.md', *(path for path, _, _ in inputs)]
+    copyrights = sorted((dependency_prefix / 'share').glob('*/copyright'))
+    for name in ['eigen3', 'cpptrace', 'urdfdom', 'libdwarf']:
+        required.append(dependency_prefix / 'share' / name / 'copyright')
+    for path in required:
+        if not path.is_file():
+            raise RuntimeError('required component license/source input is missing: ' + str(path))
+    for path in copyrights:
+        relative = path.relative_to(dependency_prefix / 'share').as_posix()
+        inputs.append((path, 'dependencies/' + relative, 'dependency-prefix/share/' + relative))
+    return inputs
+
+
+def stage_license_materials(source: Path, dependency_prefix: Path, stage: Path):
+    inputs = license_inputs(source, dependency_prefix)
+    tools = source / 'tools/wheel_cuda128'
+    stage.mkdir(parents=True, exist_ok=True)
+    shutil.copy2(source / 'NOTICE', stage / 'NOTICE')
+    shutil.copy2(tools / 'DISTRIBUTION-LICENSE.txt', stage / 'LICENSE')
+    licenses = stage / 'LICENSES'
+    licenses.mkdir()
+    shutil.copy2(tools / 'THIRD_PARTY_NOTICES.md', licenses / 'THIRD_PARTY_NOTICES.md')
+    files = []
+    for path, name, origin in inputs:
+        destination = licenses / name
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(path, destination)
+        files.append({'file': 'LICENSES/' + name, 'origin': origin,
+                      'sha256': hashlib.sha256(destination.read_bytes()).hexdigest()})
+    inventory = {
+        'notice': 'NOTICE', 'license_summary': 'LICENSE',
+        'own_contribution_license': 'MPL-2.0',
+        'own_copyright': 'Copyright (c) 2023-2026, AgiBot Inc. All Rights Reserved.',
+        'own_author': 'Genie Sim Team',
+        'upstream_python_license': 'Original GPLv3 text retained verbatim; the upstream classifier correction does not change that file',
+        'dependency_notice_scope': 'Copyright files from the supplied build prefix are retained; not every listed build dependency is necessarily linked into the wheel',
+        'binary_redistribution_note': 'For statically linked LGPL components such as libdwarf, verify and provide corresponding source and relinking materials or another applicable LGPL distribution arrangement before redistribution',
+        'files': files,
+    }
+    (licenses / 'inventory.json').write_text(json.dumps(inventory, indent=2) + '\n', encoding='utf-8')
+    return inventory
