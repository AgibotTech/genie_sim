+#!/usr/bin/env python3
+# Genie Sim Team contributions: CUDA 12.8 wheel build and packaging support.
+# This notice covers our additions and modifications, not pre-existing
+# libuipc, NVIDIA, Eigen, or vendored third-party code.
+# Copyright (c) 2023-2026, AgiBot Inc. All Rights Reserved.
+# Author: Genie Sim Team
+# License: Mozilla Public License Version 2.0
+# SPDX-License-Identifier: MPL-2.0
+#
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+"""Build the vendored CUDA 12.8 wheel dependencies without changing their inputs.
+
+Requires Python 3.9+, CMake, Ninja, GCC-compatible C/C++ compilers, and an existing
+vcpkg x64-linux prefix providing libdwarf, zstd, zlib, console_bridge, tinyxml,
+and urdfdom_headers. No network access or vcpkg install is performed.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shlex
+import shutil
+import subprocess
+import sys
+
+
+def parse_arguments() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--dependency-prefix', required=True, type=Path,
+                        help='existing vcpkg x64-linux installation (read only)')
+    parser.add_argument('--work-dir', required=True, type=Path,
+                        help='separate directory for build/, install/, and logs/')
+    parser.add_argument('--vendor-dir', type=Path,
+                        default=Path(__file__).resolve().parent / 'vendor',
+                        help='source directory containing cpptrace-1.0.2/ and urdfdom-3.1.1/')
+    parser.add_argument('--cmake', default='cmake', help='CMake executable or command name')
+    parser.add_argument('--cc', default='gcc', help='GCC-compatible C compiler')
+    parser.add_argument('--cxx', default='g++', help='GCC-compatible C++ compiler')
+    parser.add_argument('--jobs', type=int, default=min(os.cpu_count() or 1, 8),
+                        help='parallel build jobs (default: at most 8)')
+    return parser.parse_args()
+
+
+def executable(value: str) -> str:
+    found = shutil.which(value)
+    if not found:
+        raise ValueError(f'executable not found: {value}')
+    return str(Path(found).resolve())
+
+
+def build(args: argparse.Namespace) -> None:
+    prefix, work, vendor = (path.expanduser().resolve() for path in
+                            (args.dependency_prefix, args.work_dir, args.vendor_dir))
+    if args.jobs < 1:
+        raise ValueError('--jobs must be positive')
+    if not (prefix / 'include').is_dir() or not (prefix / 'lib').is_dir():
+        raise ValueError('dependency prefix must contain include/ and lib/')
+    for library in ['libdwarf.a', 'libzstd.a', 'libz.a', 'libconsole_bridge.a', 'libtinyxml.a']:
+        if not (prefix / 'lib' / library).is_file():
+            raise ValueError(f'dependency prefix is missing lib/{library}')
+    for source in ['cpptrace-1.0.2', 'urdfdom-3.1.1']:
+        if not (vendor / source / 'CMakeLists.txt').is_file():
+            raise ValueError(f'vendor directory is missing {source}/CMakeLists.txt')
+    if work == prefix or prefix in work.parents or work == vendor or vendor in work.parents:
+        raise ValueError('work directory must be outside dependency-prefix and vendor-dir')
+    # These characters conflict with CMake list syntax or GCC prefix-map syntax.
+    for path in (prefix, work, vendor):
+        if any(character in str(path) for character in [';', '=', '\n', '\r']):
+            raise ValueError('input paths must not contain semicolons, equals signs, or newlines')
+    cmake, cc, cxx, ninja = map(executable, [args.cmake, args.cc, args.cxx, 'ninja'])
+    env = os.environ.copy()
+    for name in ['CC', 'CXX', 'CFLAGS', 'CXXFLAGS', 'CPPFLAGS', 'LDFLAGS', 'CPATH',
+                 'CPLUS_INCLUDE_PATH', 'C_INCLUDE_PATH', 'LIBRARY_PATH', 'LD_LIBRARY_PATH',
+                 'CMAKE_PREFIX_PATH', 'CMAKE_TOOLCHAIN_FILE', 'CMAKE_GENERATOR',
+                 'PKG_CONFIG_PATH', 'PKG_CONFIG_LIBDIR']:
+        env.pop(name, None)
+    env['CCACHE_DISABLE'] = '1'
+    logs = work / 'logs'
+    logs.mkdir(parents=True, exist_ok=True)
+    install = work / 'install'
+    commands: list[dict[str, object]] = []
+
+    def run(label: str, command: list[str]) -> None:
+        commands.append({'step': label, 'command': command})
+        (logs / 'commands.json').write_text(json.dumps(commands, indent=2) + '\n')
+        print(label, flush=True)
+        log_path = logs / (label + '.log')
+        with log_path.open('w') as log:
+            result = subprocess.run(command, env=env, stdout=log, stderr=subprocess.STDOUT)
+        if result.returncode:
+            print(log_path.read_text(errors='replace')[-8000:], file=sys.stderr)
+            raise subprocess.CalledProcessError(result.returncode, command)
+
+    # GCC uses its last matching map. Sources take precedence over the general
+    # build-directory map, including when a caller stores sources under work/.
+    maps = [(work, 'third_party/build'), (prefix, 'third_party/dependencies'),
+            (vendor, 'third_party/source')]
+    flags = shlex.join([f'-f{kind}-prefix-map={old}={new}'
+                        for old, new in maps for kind in ['file', 'macro']])
+    common = [
+        '-G', 'Ninja', f'-DCMAKE_MAKE_PROGRAM={ninja}',
+        '-DCMAKE_BUILD_TYPE=Release', f'-DCMAKE_C_COMPILER={cc}',
+        f'-DCMAKE_CXX_COMPILER={cxx}', '-DCMAKE_EXPORT_COMPILE_COMMANDS=ON',
+        '-DCMAKE_POSITION_INDEPENDENT_CODE=ON', f'-DCMAKE_C_FLAGS={flags}',
+        f'-DCMAKE_CXX_FLAGS={flags}', '-DCMAKE_C_FLAGS_RELEASE=-O3 -DNDEBUG',
+        '-DCMAKE_CXX_FLAGS_RELEASE=-O3 -DNDEBUG', f'-DCMAKE_INSTALL_PREFIX={install}',
+        '-DCMAKE_INSTALL_LIBDIR=lib', f'-DCMAKE_PREFIX_PATH={prefix}',
+        '-DCMAKE_SKIP_RPATH=OFF', '-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON',
+        '-DCMAKE_INSTALL_RPATH=$ORIGIN', '-DCCACHE_PROGRAM=CCACHE_PROGRAM-NOTFOUND',
+    ]
+    cmake_version = subprocess.check_output([cmake, '--version'], env=env, text=True)
+    if re.search(r'cmake version ([4-9]|[1-9][0-9])\.', cmake_version):
+        common.append('-DCMAKE_POLICY_VERSION_MINIMUM=3.5')
+    cpptrace_build = work / 'build/cpptrace'
+    run('cpptrace-configure', [cmake, '-S', str(vendor / 'cpptrace-1.0.2'),
+        '-B', str(cpptrace_build), *common, '-DBUILD_SHARED_LIBS=OFF',
+        '-DBUILD_TESTING=OFF', '-DCPPTRACE_BUILD_TESTING=OFF',
+        '-DCPPTRACE_BUILD_SHARED=OFF', '-DCPPTRACE_BUILD_TOOLS=OFF',
+        '-DCPPTRACE_VCPKG=ON', '-DCPPTRACE_USE_EXTERNAL_LIBDWARF=ON',
+        '-DCPPTRACE_USE_EXTERNAL_ZSTD=ON'])
+    run('cpptrace-build', [cmake, '--build', str(cpptrace_build), '--target',
+        'cpptrace-lib', '--parallel', str(args.jobs), '--verbose'])
+    run('cpptrace-install', [cmake, '--install', str(cpptrace_build)])
+    urdfdom_build = work / 'build/urdfdom'
+    run('urdfdom-configure', [cmake, '-S', str(vendor / 'urdfdom-3.1.1'),
+        '-B', str(urdfdom_build), *common, '-DBUILD_TESTING=OFF',
+        '-DBUILD_SHARED_LIBS=ON', f'-DTinyXML_INCLUDE_DIRS={prefix / "include"}',
+        f'-DTinyXML_LIBRARIES={prefix / "lib/libtinyxml.a"}',
+        '-DAPPEND_PROJECT_NAME_TO_INCLUDEDIR=OFF'])
+    run('urdfdom-build', [cmake, '--build', str(urdfdom_build), '--target',
+        'urdfdom_model', 'urdfdom_world', 'urdfdom_sensor', 'urdfdom_model_state',
+        '--parallel', str(args.jobs), '--verbose'])
+    library_dir = install / 'lib'
+    for source in sorted((urdfdom_build / 'lib').glob('liburdfdom*.so*')):
+        target = library_dir / source.name
+        if target.is_symlink() or target.exists():
+            target.unlink()
+        if source.is_symlink():
+            target.symlink_to(os.readlink(source))
+        else:
+            shutil.copy2(source, target)
+    expected = ['libcpptrace.a'] + [f'liburdfdom_{name}.so.3.0'
+                                  for name in ['model', 'world', 'sensor', 'model_state']]
+    hashes = {}
+    for name in expected:
+        path = library_dir / name
+        if not path.is_file():
+            raise RuntimeError(f'expected library was not built: {name}')
+        hashes[name] = hashlib.sha256(path.read_bytes()).hexdigest()
+    # This portable summary deliberately records no absolute input/build paths.
+    summary = {'dependencies': {'cpptrace': '1.0.2', 'urdfdom': '3.1.1'},
+               'configuration': 'Release', 'optimization': '-O3 -DNDEBUG',
+               'source_prefix': 'third_party/source', 'runpath': '$ORIGIN',
+               'native_sha256': hashes}
+    (work / 'build-summary.json').write_text(json.dumps(summary, indent=2) + '\n')
+    print('Built dependencies in ' + str(library_dir), flush=True)
+
+
+def main() -> int:
+    try:
+        build(parse_arguments())
+    except (ValueError, OSError, RuntimeError, subprocess.CalledProcessError) as error:
+        print(f'ERROR: {error}', file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
