+        const auto yellow  = use_color ? ESC "33m" : "";
+        const auto blue    = use_color ? ESC "34m" : "";
+        const auto frame_number_width = cpptrace::detail::n_digits(cpptrace::detail::to<unsigned>(trace->count - 1));
