+        NODISCARD Result<bool, parse_error> accept_pointer_ref(bool append) {
+            bool matched = false;
+            while(true) {
+                TRY_TOK(token, tokenizer.peek());
+                if(!token || !is_pointer_ref(token.unwrap())) {
