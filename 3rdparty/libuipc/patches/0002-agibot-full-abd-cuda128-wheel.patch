+++ b/tools/wheel_cuda128/pathfix.cmake
@@ -0,0 +1,35 @@
+# Genie Sim Team contributions: CUDA 12.8 wheel build and packaging support.
+# This notice covers our additions and modifications, not pre-existing
+# libuipc, NVIDIA, Eigen, or vendored third-party code.
+# Copyright (c) 2023-2026, AgiBot Inc. All Rights Reserved.
+# Author: Genie Sim Team
+# License: Mozilla Public License Version 2.0
+# SPDX-License-Identifier: MPL-2.0
+#
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+# The portable counting-iterator compatibility change is tracked directly in src/.
+function(replace_path_definition target property macro value)
+    get_target_property(definitions ${target} ${property})
+    set(cleaned "")
+    foreach(definition IN LISTS definitions)
+        if(NOT definition MATCHES "^(-D)?${macro}=")
+            list(APPEND cleaned "${definition}")
+        endif()
+    endforeach()
+    list(APPEND cleaned "${macro}=R\"(${value})\"")
+    set_property(TARGET ${target} PROPERTY ${property} "${cleaned}")
+endfunction()
+
+function(uipc_apply_pathfix)
+    foreach(property COMPILE_DEFINITIONS INTERFACE_COMPILE_DEFINITIONS)
+        replace_path_definition(uipc_core ${property} UIPC_PROJECT_DIR "/usr/src/libuipc")
+    endforeach()
+    foreach(target cuda none)
+        replace_path_definition(${target} COMPILE_DEFINITIONS UIPC_BACKEND_DIR "/usr/src/libuipc/src/backends")
+    endforeach()
+endfunction()
+
+cmake_language(DEFER CALL uipc_apply_pathfix)
