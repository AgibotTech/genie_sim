+      }
+    }
+  }
+  
+  TiXmlElement *vertical = config->FirstChildElement("vertical");
+  if (vertical)
+  {
+    const char* samples_char = vertical->Attribute("samples");
+    if (samples_char)
+    {
+      try
+      {
+        ray.vertical_samples = std::stoul(samples_char);
+      }
+      catch (std::invalid_argument &e)
