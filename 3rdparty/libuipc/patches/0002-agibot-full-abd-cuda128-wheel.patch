+#!/usr/bin/env python3
+# Genie Sim Team contributions: CUDA 12.8 wheel build and packaging support.
+# This notice covers our additions and modifications, not pre-existing
+# libuipc, NVIDIA, Eigen, or vendored third-party code.
+# Copyright (c) 2023-2026, AgiBot Inc. All Rights Reserved.
+# Author: Genie Sim Team
+# License: Mozilla Public License Version 2.0
+# SPDX-License-Identifier: MPL-2.0
+#
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+"""Package an existing path-clean CUDA 12.8 build; never invokes CMake or NVCC.
+
+Install this recipe at tools/wheel_cuda128/package_wheel.py in the source repo.
+Use --check-config for read-only validation. This revision has its own package
+version; a rebuild is not expected to reproduce a historical archive bytewise.
+"""
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tomllib
+import zipfile
+from urllib.parse import urlsplit
+
+from license_materials import license_inputs, stage_license_materials
+
+BASE_COMMIT = '292c98c3fec2dfbe9ae2c2407572f2f446a4a738'
+CUDA_SOURCE = 'src/backends/cuda/dytopo_effect_system/global_dytopo_effect_manager.cu'
+VERSION_TEMPLATE = '0.9.0+pdfopt.ef5bfa2.sm{arch}.cu128.licensefix2.pathfix1'
+NATIVE_FILES = ('libuipc_backend_cuda.so', 'libuipc_backend_none.so',
+                'libuipc_constitution.so', 'libuipc_core.so', 'libuipc_geometry.so',
+                'libuipc_io.so', 'libuipc_sanity_check.so',
+                'pyuipc.cpython-312-x86_64-linux-gnu.so')
+PRIVATE_PATH = re.compile(r'/(?:home|root|Users|tmp)/|/data/data/|/(?:private|var)/tmp/|(?i:[a-z]:[\\/](?:Users|Documents and Settings|Temp)[\\/])')
+BINARY_SETUP = '''from setuptools import Distribution, setup
+
+class BinaryDistribution(Distribution):
+    def has_ext_modules(self):
+        return True
+
+setup(distclass=BinaryDistribution)
+'''
+
+
+def require(condition: bool, message: str):
+    if not condition:
+        raise RuntimeError(message)
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open('rb') as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def executable(value: str) -> Path:
+    found = shutil.which(value)
+    require(found is not None, f'executable not found: {value}')
+    # Preserve a venv executable's spelling: resolving its symlink changes the
+    # selected Python environment even though the interpreter binary is shared.
+    return Path(found).absolute()
+
+
+@dataclass(frozen=True)
+class Config:
+    arch: str
+    source: Path
+    build: Path
+    python: Path
+    cuda: Path
+    clean_lib: Path
+    output: Path
+    work: Path
+    source_url: str | None = None
+
+    @property
+    def version(self):
+        return VERSION_TEMPLATE.format(arch=self.arch)
+
+    @property
+    def stage(self):
+        return self.work / 'stage'
+
+    @property
+    def wheel_name(self):
+        return f'pyuipc-{self.version}-cp312-cp312-linux_x86_64.whl'
+
+
+def parse_args(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--arch', required=True, choices=['89', '120'])
+    parser.add_argument('--build-dir', required=True, type=Path)
+    parser.add_argument('--python', required=True, help='CPython 3.12 executable, including its venv path')
+    parser.add_argument('--cuda-root', required=True, type=Path)
+    parser.add_argument('--clean-dependency-lib', required=True, type=Path)
+    parser.add_argument('--output-dir', required=True, type=Path)
+    parser.add_argument('--work-dir', required=True, type=Path, help='fresh staging/log directory')
+    parser.add_argument('--check-config', action='store_true', help='validate inputs without staging or packaging')
+    parser.add_argument('--source-url', help='public HTTPS location of this exact patched source or patch release')
+    return parser.parse_args(argv)
+
+
+def configuration(args, source=None):
+    return Config(args.arch, (source or Path(__file__).resolve().parents[2]).resolve(),
+                  args.build_dir.resolve(), executable(args.python), args.cuda_root.resolve(),
+                  args.clean_dependency_lib.resolve(), args.output_dir.resolve(), args.work_dir.resolve(),
+                  args.source_url)
+
+
+def replace_project_value(text: str, key: str, value: str) -> str:
+    start = re.search(r'(?m)^\[project\][ \t]*(?:#.*)?$', text)
+    require(start is not None, 'pyproject.toml has no [project] section')
+    end = re.search(r'(?m)^\[', text[start.end():])
+    stop = start.end() + end.start() if end else len(text)
+    block = text[start.end():stop]
+    expression = re.compile(r'(?m)^([ \t]*' + re.escape(key) + r'[ \t]*=[ \t]*)(["\']).*?\2([ \t]*(?:#.*)?)$')
+    block, count = expression.subn(lambda match: match.group(1) + json.dumps(value) + match.group(3), block)
+    require(count == 1, f'expected exactly one project {key} assignment')
+    return text[:start.end()] + block + text[stop:]
+
+
+def prepare_pyproject(text: str, arch: str, version: str) -> str:
+    original = tomllib.loads(text)
+    project = original['project']
+    require(project['name'] == 'pyuipc', 'source project is not pyuipc')
+    text = replace_project_value(text, 'version', version)
+    text = replace_project_value(text, 'requires-python', '==3.12.*')
+    description = project.get('description', '').replace('CUDA 12.6+ required',
+                                                       f'CUDA 12.8 libraries required; sm_{arch}')
+    text = replace_project_value(text, 'description', description)
+    text = re.sub(r'(?m)^[ \t]*["\']Programming Language :: Python :: 3\.(?!12["\'])\d+["\'],?[ \t]*\n', '', text)
+    # The wheel contains separately licensed components. Its LICENSE summary
+    # and original component texts are authoritative; a single classifier
+    # must not silently replace the upstream Python GPL license text.
+    text = re.sub(r'(?m)^[ \t]*["\']License ::[^\n]*\n', '', text)
+    text += '\n[tool.setuptools]\nlicense-files = ["LICENSE", "NOTICE", "LICENSES/**/*"]\n'
+    section = re.search(r'(?ms)^\[tool\.setuptools\.package-data\][ \t]*\n(.*?)(?=^\[|\Z)', text)
+    require(section is not None, 'source has no setuptools package-data section')
+    block = section.group(1)
+    pattern = re.compile(r'(?ms)^([ \t]*["\']\*["\'][ \t]*=[ \t]*)\[(.*?)\]')
+    def add_manifest(match):
+        body = match.group(2).rstrip().rstrip(',')
+        return match.group(1) + '[' + body + (', ' if body.strip() else '') + '"build_manifest.json"]'
+    if 'build_manifest.json' not in original.get('tool', {}).get('setuptools', {}).get('package-data', {}).get('*', []):
+        block, count = pattern.subn(add_manifest, block)
+        require(count == 1, 'expected one wildcard setuptools package-data assignment')
+        text = text[:section.start(1)] + block + text[section.end(1):]
+    packaged = tomllib.loads(text)
+    require(packaged['project']['dependencies'] == project['dependencies'], 'runtime dependencies changed')
+    require(packaged['project'].get('optional-dependencies') == project.get('optional-dependencies'),
+            'optional dependencies changed')
+    require(not any(value.startswith('License ::') for value in packaged['project']['classifiers']),
+            'component licensing was replaced by a blanket license classifier')
+    require(packaged['project']['requires-python'] == '==3.12.*', 'Python requirement was not set')
+    require('build_manifest.json' in packaged['tool']['setuptools']['package-data']['*'],
+            'manifest was not included in package data')
+    return text
+
+
+def git(source: Path, *arguments):
+    return subprocess.check_output(['git', '-C', str(source), *arguments], text=True).strip()
+
+
+def source_provenance(source: Path):
+    commit = git(source, 'rev-parse', 'HEAD')
+    require(re.fullmatch(r'[0-9a-f]{40,64}', commit) is not None, 'cannot identify source Git HEAD')
+    dirty = bool(git(source, 'status', '--porcelain', '--untracked-files=no'))
+    submodules = []
+    for line in git(source, 'submodule', 'status', '--recursive').splitlines():
+        match = re.match(r'^[ +\-U]?([0-9a-f]{40})[ \t]+([^ \t]+)', line)
+        require(match is not None, 'cannot parse submodule status')
+        path = Path(match.group(2))
+        require(not path.is_absolute() and '..' not in path.parts, 'submodule path must be relative')
+        submodules.append({'path': path.as_posix(), 'commit': match.group(1)})
+    return commit, dirty, submodules
+
+
+
+def validate_cuda_toolchain(config: Config):
+    """Reject a different toolkit or a build made with another compiler."""
+    version_file = config.cuda / 'version.json'
+    require(version_file.is_file(), 'CUDA toolkit version.json is missing')
+    versions = json.loads(version_file.read_text(encoding='utf-8'))
+    require(re.match(r'^12\.8(?:\.|$)', str(versions.get('cuda', {}).get('version', ''))) is not None,
+            'CUDA root is not a CUDA 12.8 toolkit')
+    require((config.cuda / 'lib64/libcudart.so.12').is_file(), 'CUDA 12 runtime library is missing')
+    cache = config.build / 'CMakeCache.txt'
+    require(cache.is_file(), 'native build CMakeCache.txt is missing')
+    match = re.search(r'(?m)^CMAKE_CUDA_COMPILER:(?:FILEPATH|STRING)=(.+)$',
+                      cache.read_text(encoding='utf-8'))
+    require(match is not None, 'native build CUDA compiler is not recorded in CMakeCache.txt')
+    require(Path(match.group(1).strip()).resolve() == (config.cuda / 'bin/nvcc').resolve(),
+            'native build CUDA compiler differs from --cuda-root; rebuild with CUDA 12.8')
+    return versions
+
+
+def validate(config: Config, require_clean: bool = True):
+    require(config.arch in ['89', '120'], 'architecture must be 89 or 120')
+    versions = validate_cuda_toolchain(config)
+    if config.source_url:
+        url = urlsplit(config.source_url)
+        require(url.scheme == 'https' and bool(url.hostname) and not url.username
+                and not url.password and not url.query,
+                '--source-url must be an HTTPS source location without credentials or query tokens')
+    license_inputs(config.source, config.build / 'vcpkg_installed/x64-linux')
+    for path in [config.source / 'README.md', config.source / 'LICENSE', config.source / 'python/pyproject.toml',
+                 config.source / CUDA_SOURCE, config.build / 'python/src/uipc/__init__.py',
+                 config.build / 'RelWithDebInfo/bin/libuipc_backend_cuda.so',
+                 config.build / 'RelWithDebInfo/bin/pyuipc.cpython-312-x86_64-linux-gnu.so',
+                 config.cuda / 'version.json', config.cuda / 'bin/cuobjdump',
+                 config.cuda / 'lib64/libcudart.so.12']:
+        require(path.is_file(), f'required input is missing: {path}')
+    require(not config.stage.exists(), 'work-dir/stage exists; choose a fresh work directory')
+    require(not (config.output / config.wheel_name).exists(), 'output wheel already exists; choose a fresh output directory')
+    require(not config.work.is_relative_to(config.build), 'work-dir must not be inside build-dir')
+    require(not config.build.is_relative_to(config.work), 'work-dir must not contain build-dir')
+    for tool in ['strip', 'patchelf']:
+        executable(tool)
+    libs = sorted(config.clean_lib.glob('liburdfdom*.so*'))
+    require(libs and all(path.is_file() for path in libs), 'clean-dependency-lib has no complete urdfdom libraries')
+    for library in ['model', 'model_state', 'sensor', 'world']:
+        require((config.clean_lib / f'liburdfdom_{library}.so').is_file(), f'clean urdfdom {library} library is missing')
+    probe = ('import importlib.util,json,platform,sys; '
+             'print(json.dumps({"implementation":platform.python_implementation(),'
+             '"version":list(sys.version_info[:2]),"system":platform.system(),'
+             '"machine":platform.machine(),"tools":{n:importlib.util.find_spec(n) is not None '
+             'for n in ["setuptools","wheel","pybind11_stubgen","numpy"]}}))')
+    python = json.loads(subprocess.check_output([str(config.python), '-s', '-c', probe], text=True))
+    require(python['implementation'] == 'CPython' and python['version'] == [3, 12], 'selected Python must be CPython 3.12')
+    require(python['system'] == 'Linux' and python['machine'] == 'x86_64', 'wheel target requires Linux x86_64')
+    require(all(python['tools'].values()), 'selected Python needs setuptools, wheel, pybind11_stubgen, and numpy')
+    backend = config.build / 'RelWithDebInfo/bin/libuipc_backend_cuda.so'
+    listing = subprocess.check_output([str(config.cuda / 'bin/cuobjdump'), '--all-fatbin', '--list-elf', str(backend)], text=True)
+    require(set(re.findall(r'sm_\d+[a-z]?', listing)) == {f'sm_{config.arch}'}, 'backend cubin architecture differs from --arch')
+    patched = (config.source / CUDA_SOURCE).read_text(encoding='utf-8')
+    require('#include <thrust/iterator/counting_iterator.h>' in patched and
+            'thrust::counting_iterator<IndexT>' in patched and
+            '#include <cub/iterator/counting_input_iterator.cuh>' not in patched and
+            re.search(r'(?m)^\s*cub::CountingInputIterator<IndexT>\s+virtual_indices', patched) is None,
+            'source does not contain the expected portable thrust counting-iterator compatibility change')
+    pyproject = prepare_pyproject((config.source / 'python/pyproject.toml').read_text(encoding='utf-8'), config.arch, config.version)
+    commit, dirty, submodules = source_provenance(config.source)
+    if require_clean:
+        require(not dirty, 'source has tracked modifications; commit the complete recipe/source before packaging')
+    return {'python': python, 'cuda_versions': versions, 'pyproject': pyproject,
+            'recipe_commit': commit, 'source_tracked_files_modified': dirty, 'submodules': submodules}
+
+
+def copy_regular(source: Path, destination: Path):
+    if destination.is_symlink():
+        destination.unlink()
+    shutil.copy2(source, destination, follow_symlinks=True)
+
+
+def stage_inputs(config: Config, info):
+    shutil.copytree(config.source / 'python/src', config.stage / 'src',
+                    ignore=shutil.ignore_patterns('__pycache__', '*.pyc', '*.pyo',
+                                                 '*.so', '*.so.*', '*.dll', '*.pyd', '*.dylib'))
+    native = config.stage / 'src/uipc/_native'
+    native.mkdir(parents=True, exist_ok=True)
+    # Device-only relinking need not rerun the binding's staging hook. Always
+    # override with the actual final native outputs, including the CUDA backend.
+    for name in NATIVE_FILES:
+        copy_regular(config.build / 'RelWithDebInfo/bin' / name, native / name)
+    (config.stage / 'pyproject.toml').write_text(info['pyproject'], encoding='utf-8')
+    (config.stage / 'setup.py').write_text(BINARY_SETUP, encoding='utf-8')
+    copy_regular(config.source / 'README.md', config.stage / 'README.md')
+    info['license_materials'] = stage_license_materials(
+        config.source, config.build / 'vcpkg_installed/x64-linux', config.stage)
+    return native
+
+
+def build_manifest(config: Config, info, native: Path):
+    manifest = {
+        'distribution': 'pyuipc', 'version': config.version,
+        'built_at': datetime.now(timezone.utc).isoformat(),
+        'source_base_repository': 'https://github.com/spiriMirror/libuipc', 'source_root': 'libuipc',
+        'source_base_commit': BASE_COMMIT, 'source_commit': info['recipe_commit'],
+        'build_recipe_commit': info['recipe_commit'], 'build_recipe': 'tools/wheel_cuda128/package_wheel.py',
+        'source_tracked_files_modified': False, 'submodules': info['submodules'],
+        'reproduction_scope': 'Rebuild recipe; byte-identical reproduction of a historical wheel archive is not guaranteed',
+        'source_tree': git(config.source, 'rev-parse', 'HEAD^{tree}'),
+        'source_identity_scope': 'Tracked Git tree; untracked input files are not certified by this identifier',
+        'patched_source_url': config.source_url,
+        'source_location_note': 'Local commit identity does not imply publication on the upstream repository; publish the exact source/patch release when redistributing binaries',
+        'license_materials': info['license_materials'],
+        'source_compatibility': {'file': CUDA_SOURCE,
+            'change': 'Use thrust::counting_iterator available in CUDA 12.8; numerical behavior unchanged',
+            'source_sha256': sha256(config.source / CUDA_SOURCE)},
+        'path_cleanup': {'method': 'Compile-time prefix maps and explicit nvlink archive inputs',
+            'mapped_source_root': 'libuipc', 'mapped_other_build_paths': 'build-host',
+            'virtual_project_root': '/usr/src/libuipc', 'virtual_backend_root': '/usr/src/libuipc/src/backends',
+            'third_party_rebuilt': ['cpptrace 1.0.2 (static)', 'urdfdom 3.1.1 (shared)'],
+            'diagnostic_line_numbers_preserved': True, 'post_link_binary_string_replacement': False},
+        'cuda_toolkit': info['cuda_versions']['cuda']['version'],
+        'nvcc_version': info['cuda_versions'].get('cuda_nvcc', {}).get('version'),
+        'cuda_component_versions': info['cuda_versions'], 'recommended_runtime_driver_branch': 'R570 or newer with support for the selected GPU',
+        'cuda_architectures': [config.arch], 'build_type': 'RelWithDebInfo',
+        'optimization_flags': '-O3 -g -DNDEBUG', 'muda_runtime_checks': False,
+        'python_abi': 'cp312', 'platform': 'linux_x86_64',
+        'runtime_requirements': ['CPython 3.12', 'Linux x86_64', f'sm_{config.arch} GPU',
+            'NVIDIA driver compatible with CUDA 12.8 and the selected GPU (R570 or newer recommended)', 'CUDA 12.8 runtime, cuBLAS, cuSPARSE, cuSOLVER and their dependencies'],
+        'python_dependencies': 'Unchanged from source pyproject.toml, including huggingface_hub for uipc.assets',
+        'packaging_changes': ['binary CPython 3.12 wheel', 'bundle clean urdfdom', 'strip debug symbols',
+            'RPATH=$ORIGIN', 'sanitized source/recipe manifest', 'preserve separate component licenses and covered source'],
+        'native_sha256': {path.name: sha256(path) for path in sorted(native.glob('*.so*')) if path.is_file()},
+    }
+    text = json.dumps(manifest, indent=2, ensure_ascii=False) + '\n'
+    require(PRIVATE_PATH.search(text) is None, 'manifest contains a private build-host path')
+    return text
+
+
+def package(config: Config, info):
+    config.work.mkdir(parents=True, exist_ok=True)
+    config.output.mkdir(parents=True, exist_ok=True)
+    native = stage_inputs(config, info)
+    env = os.environ.copy()
+    env.pop('PYTHONHOME', None)
+    env.pop('LD_PRELOAD', None)
+    env['PYTHONPATH'] = str(config.stage / 'src')
+    env['PYTHONNOUSERSITE'] = '1'
+    env['LD_LIBRARY_PATH'] = os.pathsep.join(map(str, [config.cuda / 'lib64', config.clean_lib]))
+    env['PIP_DISABLE_PIP_VERSION_CHECK'] = '1'
+    with (config.work / 'stubgen.log').open('w', encoding='utf-8') as log:
+        subprocess.run([str(config.python), '-s', '-P', '-m', 'pybind11_stubgen', 'uipc', '-o', str(config.stage / 'src'),
+                        '--ignore-unresolved-names', 'json'], env=env, cwd=config.work, stdout=log, stderr=subprocess.STDOUT, check=True)
+    for path in sorted(config.clean_lib.glob('liburdfdom*.so*')):
+        copy_regular(path, native / path.name)
+    for path in sorted(native.glob('*.so*')):
+        require(path.is_file(), f'broken native library: {path.name}')
+        subprocess.run(['strip', '--strip-debug', str(path)], check=True)
+        subprocess.run(['patchelf', '--set-rpath', '$ORIGIN', str(path)], check=True)
+    manifest = build_manifest(config, info, native)
+    (native / 'build_manifest.json').write_text(manifest, encoding='utf-8')
+    (config.output / f'sm{config.arch}-build_manifest.json').write_text(manifest, encoding='utf-8')
+    with (config.work / 'package.log').open('w', encoding='utf-8') as log:
+        subprocess.run([str(config.python), '-s', '-m', 'pip', 'wheel', str(config.stage), '--no-deps',
+                        '--no-build-isolation', '--no-index', '--no-cache-dir', '--wheel-dir', str(config.output)],
+                       env=env, stdout=log, stderr=subprocess.STDOUT, check=True)
+    wheel = config.output / config.wheel_name
+    require(wheel.is_file(), 'packager did not emit the expected cp312-cp312-linux_x86_64 wheel')
+    with zipfile.ZipFile(wheel) as archive:
+        wheel_info = next(name for name in archive.namelist() if name.endswith('.dist-info/WHEEL'))
+        metadata = archive.read(wheel_info).decode('utf-8')
+        require('Root-Is-Purelib: false' in metadata and 'Tag: cp312-cp312-linux_x86_64' in metadata,
+                'packaged wheel has incorrect binary tag')
+    digest = sha256(wheel)
+    (config.output / (wheel.name + '.sha256')).write_text(f'{digest}  {wheel.name}\n', encoding='utf-8')
+    return wheel, digest
+
+
+def main(argv=None):
+    args = parse_args(argv)
+    try:
+        config = configuration(args)
+        info = validate(config, require_clean=not args.check_config)
+        if args.check_config:
+            print(json.dumps({'status': 'CONFIG_PASS', 'architecture': config.arch, 'version': config.version,
+                              'wheel': config.wheel_name, 'build_recipe_commit': info['recipe_commit'],
+                              'cuda_toolkit': info['cuda_versions']['cuda']['version'], 'python_abi': 'cp312',
+                              'source_tracked_files_modified': info['source_tracked_files_modified'],
+                              'runtime_dependencies_unchanged': True, 'packaging_performed': False}, indent=2))
+            return 0
+        wheel, digest = package(config, info)
+        print(wheel)
+        print('SHA256', digest)
+        return 0
+    except (OSError, RuntimeError, ValueError, subprocess.CalledProcessError, tomllib.TOMLDecodeError) as exc:
+        print(f'ERROR: {exc}', file=sys.stderr)
+        return 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
