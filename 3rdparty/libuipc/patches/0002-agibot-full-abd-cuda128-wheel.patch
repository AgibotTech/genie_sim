+                }
+                matched = true;
+                if(append) {
+                    append_output(token.unwrap());
+                }
+                tokenizer.advance();
+            }
+            return matched;
+        }
+
+        NODISCARD Result<bool, parse_error> consume_balanced(string_view opening_punctuation) {
