+#ifdef CPPTRACE_GET_SYMBOLS_WITH_LIBDWARF
+
+#include "symbols/symbols.hpp"
+
+#include <cpptrace/basic.hpp>
+
+#include "dwarf/resolver.hpp"
+#include "utils/common.hpp"
+#include "utils/utils.hpp"
