+        template<typename R, typename F, typename Arg>
+        Arg get_callable_argument_helper(R(F::*) (Arg) const);
+        template<typename R>
+        void get_callable_argument_helper(R(*) ());
+        template<typename R, typename F>
+        void get_callable_argument_helper(R(F::*) ());
+        template<typename R, typename F>
