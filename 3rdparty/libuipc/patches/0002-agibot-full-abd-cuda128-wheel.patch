+    #if IS_LIBSTDCXX
+        constexpr size_t vtable_size = 11;
+    #elif IS_LIBCXX
+        constexpr size_t vtable_size = 10;
+    #else
+        #warning "Cpptrace from_current: Unrecognized C++ standard library, from_current() won't be supported"
+        constexpr size_t vtable_size = 0;
+    #endif
