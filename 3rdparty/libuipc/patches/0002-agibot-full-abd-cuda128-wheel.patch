+#!/usr/bin/env python3
+# Genie Sim Team contributions: CUDA 12.8 wheel build and packaging support.
+# This notice covers our additions and modifications, not pre-existing
+# libuipc, NVIDIA, Eigen, or vendored third-party code.
+# Copyright (c) 2023-2026, AgiBot Inc. All Rights Reserved.
+# Author: Genie Sim Team
+# License: Mozilla Public License Version 2.0
+# SPDX-License-Identifier: MPL-2.0
+#
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+"""Build the CUDA 12.8 native inputs for the sm89 and sm120 Python wheels.
+
+Install this file at tools/wheel_cuda128/build_wheels.py in the source checkout.
+The CUDA compatibility change must already be in that checkout. Supply
+provisioned dependencies; this driver installs no system
+packages and never modifies the dependency inputs. Wheel packaging is a separate
+step consuming each build/python directory.
+
+Example (replace the external input paths):
+  python3 tools/wheel_cuda128/build_wheels.py --arch both \
+    --work-dir /build/uipc-cu128 --cuda-root /opt/cuda-12.8 \
+    --dependency-prefix /opt/uipc-dependencies/x64-linux \
+    --clean-dependency-lib /opt/uipc-clean-dependencies/lib \
+    --python python3.12 --cmake cmake --vcpkg-root /opt/vcpkg
+
+Add --dry-run to print the complete plan without writing or running anything.
+Add --configure-only to prepare fresh environments and configure without building.
+Each invocation needs fresh architecture directories under --work-dir. To build
+after a configure-only run, use the recorded cmake --build command or another
+fresh work directory.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import shlex
+import shutil
+import subprocess
+import sys
+import time
+
+
+RELATIVE_CUDA_SOURCE = 'src/backends/cuda/dytopo_effect_system/global_dytopo_effect_manager.cu'
+COMPANIONS = ('pathfix.cmake', 'pre_project.cmake', 'cuda_rules.cmake', 'device_link.py',
+              'vcpkg.json', 'vcpkg-configuration.json', 'python-build-requirements.txt')
+
+
+def executable(value):
+    """Keep interpreter symlinks intact so the selected environment is retained."""
+    expanded = os.path.expanduser(value)
+    if os.sep in expanded:
+        return str(Path(expanded).absolute())
+    return shutil.which(expanded) or expanded
+
+
+def arguments(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('--arch', choices=('89', '120', 'both'), default='both')
+    parser.add_argument('--work-dir', required=True, type=Path, help='fresh per-architecture outputs are created here')
+    parser.add_argument('--cuda-root', required=True, type=Path, help='CUDA 12.8 toolkit containing bin/nvcc, include, and lib64')
+    parser.add_argument('--dependency-prefix', required=True, type=Path, help='provisioned vcpkg x64-linux prefix; copied, never edited')
+    parser.add_argument('--clean-dependency-lib', required=True, type=Path, help='rebuilt clean .a/.so libraries to overlay in the copied prefix')
+    parser.add_argument('--python', default='python3.12', help='Python 3.12 used to create an isolated venv')
+    parser.add_argument('--cmake', default='cmake', help='CMake executable, version 3.26 or newer')
+    parser.add_argument('--vcpkg-root', required=True, type=Path, help='external vcpkg checkout containing scripts/buildsystems/vcpkg.cmake')
+    parser.add_argument('--configure-only', action='store_true')
+    parser.add_argument('--dry-run', action='store_true')
+    parsed = parser.parse_args(argv)
+    for name in ('work_dir', 'cuda_root', 'dependency_prefix', 'clean_dependency_lib', 'vcpkg_root'):
+        setattr(parsed, name, getattr(parsed, name).expanduser().resolve())
+    parsed.python = executable(parsed.python)
+    parsed.cmake = executable(parsed.cmake)
+    return parsed
+
+
+def make_plan(args):
+    script_dir = Path(__file__).resolve().parent
+    source = Path(__file__).resolve().parents[2]
+    cc = executable('gcc-11')
+    cxx = executable('g++-11')
+    nvcc = str(args.cuda_root / 'bin/nvcc')
+    # GCC applies the last matching prefix. Keep checkout and exact-file maps last.
+    maps = [(str(Path.home()), 'build-host'), (str(args.work_dir), 'build-work'),
+            (str(source), 'libuipc'), (str(source / RELATIVE_CUDA_SOURCE), RELATIVE_CUDA_SOURCE)]
+    cflags = ['-ffile-prefix-map=' + old + '=' + new for old, new in maps]
+    cuda_flags = ['-Xcompiler=' + flag for flag in cflags]
+    include_cccl = '-I' + str(args.cuda_root / 'include')
+    runs = []
+    for arch in (('89', '120') if args.arch == 'both' else (args.arch,)):
+        run_root = args.work_dir / ('sm' + arch + '-cu128')
+        build = run_root / 'build'
+        venv = run_root / 'venv'
+        python = venv / 'bin/python'
+        prefix = build / 'vcpkg_installed/x64-linux'
+        configure = [
+            args.cmake, '-S', str(source), '-B', str(build), '-G', 'Ninja',
+            '-DCMAKE_BUILD_TYPE=RelWithDebInfo',
+            '-DCMAKE_CXX_FLAGS_RELWITHDEBINFO=-O3 -g -DNDEBUG',
+            '-DCMAKE_C_FLAGS_RELWITHDEBINFO=-O3 -g -DNDEBUG',
+            '-DCMAKE_CUDA_FLAGS_RELWITHDEBINFO=-O3 -g -DNDEBUG',
+            '-DCMAKE_CXX_FLAGS=' + shlex.join([include_cccl, *cflags]),
+            '-DCMAKE_C_FLAGS=' + shlex.join(cflags),
+            '-DCMAKE_CUDA_FLAGS=' + shlex.join([include_cccl, *cuda_flags]),
+            '-DCMAKE_PROJECT_uipc_INCLUDE_BEFORE=' + str(script_dir / 'pre_project.cmake'),
+            '-DCMAKE_PROJECT_uipc_INCLUDE=' + str(script_dir / 'pathfix.cmake'),
+            '-DCMAKE_USER_MAKE_RULES_OVERRIDE_CUDA=' + str(script_dir / 'cuda_rules.cmake'),
+            '-DCMAKE_C_COMPILER=' + cc, '-DCMAKE_CXX_COMPILER=' + cxx,
+            '-DCMAKE_CUDA_COMPILER=' + nvcc, '-DCMAKE_CUDA_HOST_COMPILER=' + cxx,
+            '-DCUDAToolkit_ROOT=' + str(args.cuda_root),
+            '-DCMAKE_TOOLCHAIN_FILE=' + str(args.vcpkg_root / 'scripts/buildsystems/vcpkg.cmake'),
+            '-DVCPKG_INSTALLED_DIR=' + str(build / 'vcpkg_installed'),
+            '-DVCPKG_TARGET_TRIPLET=x64-linux',
+            '-DVCPKG_MANIFEST_INSTALL=OFF',
+            '-DCMAKE_BUILD_RPATH_USE_ORIGIN=ON',
+            '-DUIPC_PYTHON_EXECUTABLE_PATH=' + str(python), '-DPython_EXECUTABLE=' + str(python),
+            '-DUIPC_CUDA_ARCHITECTURES=' + arch,
+            '-DUIPC_BUILD_PYBIND=ON', '-DUIPC_BUILD_PYTHON_WHEEL=ON',
+            '-DUIPC_BUILD_TESTS=OFF', '-DUIPC_BUILD_EXAMPLES=OFF',
+            '-DUIPC_BUILD_BENCHMARKS=OFF', '-DUIPC_BUILD_GUI=OFF',
+            '-DUIPC_WITH_CUDA_BACKEND=ON', '-DMUDA_WITH_CHECK=OFF', '-DMUDA_FORCE_CHECK=OFF',
+        ]
+        environment = {
+            'PATH': os.pathsep.join([str(venv / 'bin'), str(args.cuda_root / 'bin'), '/usr/bin', '/bin', os.environ.get('PATH', '')]),
+            'LD_LIBRARY_PATH': os.pathsep.join(filter(None, [str(args.cuda_root / 'lib64'), str(prefix / 'lib'), os.environ.get('LD_LIBRARY_PATH', '')])),
+            'PYTHONPATH': str(build / 'python/src'),
+            'PYTHONNOUSERSITE': '1', 'PIP_REQUIRE_VIRTUALENV': '1', 'PIP_DISABLE_PIP_VERSION_CHECK': '1',
+            'VCPKG_ROOT': str(args.vcpkg_root), 'VCPKG_DEFAULT_TRIPLET': 'x64-linux',
+            'CUDACXX': nvcc, 'CMAKE_BUILD_PARALLEL_LEVEL': '32',
+            'UIPC_DEVICE_LINK_AUDIT': str(run_root / 'logs/device-link.json'),
+        }
+        commands = {
+            'venv': [args.python, '-m', 'venv', str(venv)],
+            'python_dependencies': [str(python), '-m', 'pip', 'install',
+                                    '--requirement', str(script_dir / 'python-build-requirements.txt')],
+            'configure': configure,
+            'build': [args.cmake, '--build', str(build), '-j32', '--config', 'RelWithDebInfo'],
+        }
+        runs.append({'arch': arch, 'root': str(run_root), 'build': str(build), 'venv': str(venv),
+                     'dependency_copy': str(prefix), 'python_output': str(build / 'python'),
+                     'environment': environment, 'commands': commands})
+    return {'source_root': str(source), 'script_dir': str(script_dir), 'work_dir': str(args.work_dir),
+            'inputs': {'cuda_root': str(args.cuda_root), 'dependency_prefix': str(args.dependency_prefix),
+                       'clean_dependency_lib': str(args.clean_dependency_lib), 'vcpkg_root': str(args.vcpkg_root)},
+            'tools': {'python': args.python, 'cmake': args.cmake, 'cc': cc, 'cxx': cxx, 'nvcc': nvcc},
+            'prefix_maps': [{'old': old, 'new': new} for old, new in maps],
+            'configure_only': args.configure_only,
+            'preparation': ['copy dependency prefix and available sibling vcpkg metadata',
+                            'copy locked vcpkg manifests from script directory',
+                            'overlay clean library files before and after configuration'],
+            'runs': runs}
+
+
+def library_files(directory):
+    return sorted(path for path in directory.iterdir()
+                  if (path.is_file() or path.is_symlink())
+                  and (path.name.endswith('.a') or re.search(r'\.so(?:\.[^/]+)?$', path.name)))
+
+
+def validate(args, plan):
+    source = Path(plan['source_root'])
+    required = [source / 'CMakeLists.txt', source / RELATIVE_CUDA_SOURCE,
+                *(Path(plan['script_dir']) / name for name in COMPANIONS),
+                args.cuda_root / 'bin/nvcc', args.cuda_root / 'include/thrust/iterator/counting_iterator.h',
+                args.cuda_root / 'include/cub/block/block_reduce.cuh', args.vcpkg_root / 'scripts/buildsystems/vcpkg.cmake']
+    for path in required:
+        if not path.is_file():
+            raise ValueError('required input does not exist: ' + str(path))
+    for path in (args.dependency_prefix / 'include', args.dependency_prefix / 'lib',
+                 args.cuda_root / 'include', args.cuda_root / 'lib64', args.clean_dependency_lib):
+        if not path.is_dir():
+            raise ValueError('required input directory does not exist: ' + str(path))
+    if not library_files(args.clean_dependency_lib):
+        raise ValueError('--clean-dependency-lib must contain rebuilt .a/.so library files')
+    for run in plan['runs']:
+        output = Path(run['root'])
+        if output.exists() and (not output.is_dir() or any(output.iterdir())):
+            raise ValueError('use a fresh architecture directory; refusing to modify: ' + str(output))
+        copied = Path(run['dependency_copy'])
+        if copied == args.dependency_prefix or args.dependency_prefix in copied.parents:
+            raise ValueError('dependency output must not be inside the dependency input prefix')
+    for name in ('python', 'cmake', 'cc', 'cxx', 'nvcc'):
+        if shutil.which(plan['tools'][name]) is None:
+            raise ValueError('required executable not found: ' + plan['tools'][name])
+    if shutil.which('ninja') is None:
+        raise ValueError('Ninja is required on PATH')
+
+
+def versions(plan):
+    def capture(command):
+        result = subprocess.run(command, text=True, capture_output=True, check=True)
+        return (result.stdout + result.stderr).strip()
+    tools = plan['tools']
+    python = capture([tools['python'], '-c', 'import sys; print("%d.%d.%d" % sys.version_info[:3])'])
+    if not python.startswith('3.12.'):
+        raise ValueError('--python must be Python 3.12; found ' + python)
+    cmake = capture([tools['cmake'], '--version'])
+    match = re.search(r'cmake version (\d+)\.(\d+)', cmake)
+    if not match or tuple(map(int, match.groups())) < (3, 26):
+        raise ValueError('--cmake must be version 3.26 or newer')
+    gcc = capture([tools['cc'], '-dumpfullversion'])
+    gxx = capture([tools['cxx'], '-dumpfullversion'])
+    if not gcc.startswith('11.') or not gxx.startswith('11.'):
+        raise ValueError('GCC and G++ 11 are required by this build recipe')
+    nvcc = capture([tools['nvcc'], '--version'])
+    if not re.search(r'release\s+12\.8\b', nvcc):
+        raise ValueError('--cuda-root must point to a CUDA 12.8 toolkit')
+    supported = set(capture([tools['nvcc'], '--list-gpu-code']).split())
+    for run in plan['runs']:
+        if 'sm_' + run['arch'] not in supported:
+            raise ValueError('CUDA compiler does not support requested sm_' + run['arch'])
+    return {'python': python, 'cmake': cmake, 'gcc': gcc, 'gxx': gxx, 'nvcc': nvcc}
+
+
+def overlay_libraries(source, destination):
+    destination.mkdir(parents=True, exist_ok=True)
+    for library in library_files(source):
+        target = destination / library.name
+        # Unlink first: an existing symlink must never redirect writes to inputs.
+        if target.is_symlink() or target.is_file():
+            target.unlink()
+        elif target.exists():
+            raise ValueError('library overlay destination is not a file: ' + str(target))
+        if library.is_symlink():
+            target.symlink_to(os.readlink(library))
+        else:
+            shutil.copy2(library, target)
+
+
+def run_command(label, command, environment, logs):
+    print(label + ' START ' + time.strftime('%Y-%m-%dT%H:%M:%S'), flush=True)
+    log_path = logs / (label + '.log')
+    with log_path.open('w') as log:
+        result = subprocess.run(command, env=environment, stdout=log, stderr=subprocess.STDOUT)
+    print(label + ' EXIT ' + str(result.returncode) + ' ' + time.strftime('%Y-%m-%dT%H:%M:%S'), flush=True)
+    if result.returncode:
+        print(log_path.read_text(errors='replace')[-6500:], file=sys.stderr)
+        raise subprocess.CalledProcessError(result.returncode, command)
+
+
+def execute(args, plan):
+    validate(args, plan)
+    tool_versions = versions(plan)
+    for run in plan['runs']:
+        root = Path(run['root'])
+        build = Path(run['build'])
+        logs = root / 'logs'
+        logs.mkdir(parents=True, exist_ok=True)
+        build.mkdir()
+        prefix = Path(run['dependency_copy'])
+        shutil.copytree(args.dependency_prefix, prefix, symlinks=True)
+        metadata = args.dependency_prefix.parent / 'vcpkg'
+        if metadata.is_dir():
+            shutil.copytree(metadata, build / 'vcpkg_installed/vcpkg', symlinks=True,
+                            ignore=shutil.ignore_patterns('vcpkg-running.lock'))
+        for name in ('vcpkg.json', 'vcpkg-configuration.json'):
+            shutil.copy2(Path(plan['script_dir']) / name, build / name)
+        overlay_libraries(args.clean_dependency_lib, prefix / 'lib')
+        (logs / 'commands.json').write_text(json.dumps(run, indent=2) + '\n')
+        (logs / 'tool-versions.json').write_text(json.dumps(tool_versions, indent=2) + '\n')
+        environment = os.environ.copy()
+        environment.update(run['environment'])
+        run_command('venv', run['commands']['venv'], environment, logs)
+        run_command('python_dependencies', run['commands']['python_dependencies'], environment, logs)
+        run_command('configure', run['commands']['configure'], environment, logs)
+        overlay_libraries(args.clean_dependency_lib, prefix / 'lib')
+        if not args.configure_only:
+            run_command('build', run['commands']['build'], environment, logs)
+            print('Native build ready for packaging: ' + run['python_output'], flush=True)
+        else:
+            print('Configured without compiling: ' + str(build), flush=True)
+
+
+def main(argv=None):
+    args = arguments(argv)
+    plan = make_plan(args)
+    if args.dry_run:
+        print(json.dumps(plan, indent=2))
+        return 0
+    execute(args, plan)
+    return 0
+
+
+if __name__ == '__main__':
+    try:
+        sys.exit(main())
+    except (ValueError, OSError, subprocess.CalledProcessError) as error:
+        print('build_wheels.py: ' + str(error), file=sys.stderr)
+        sys.exit(error.returncode if isinstance(error, subprocess.CalledProcessError) else 2)
