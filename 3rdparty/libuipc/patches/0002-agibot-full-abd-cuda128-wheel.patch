+            return filter_result;
+        }
+        CPPTRACE_FORCE_NO_INLINE
+        void maybe_collect_trace(EXCEPTION_POINTERS* exception_ptrs, const std::type_info& type_info) {
+            if(matches_exception(exception_ptrs, type_info)) {
