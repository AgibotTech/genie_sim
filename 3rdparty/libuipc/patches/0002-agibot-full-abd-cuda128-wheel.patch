+    // produce information similar to dsymutil -dump-debug-map
+    void mach_o::print_debug_map(const debug_map& debug_map) {
+        for(const auto& entry : debug_map) {
+            std::cout<<entry.first<<": "<< '\n';
+            for(const auto& symbol : entry.second) {
